import { specifications } from '../data/shacl-support';
import { termDefinitions } from '../data/term-definitions.mjs';
---

<div class="shacl-support not-content">
  <p class="legend">
    <code class="chip supported">supported</code>
    <code class="chip unsupported">not supported</code>
  </p>
  {specifications.map((specification) => (
    <section>
      <h3>
        <a href={specification.url} target="_blank" rel="noopener noreferrer">
          {specification.title}
        </a>
      </h3>
      {specification.sets.map((set) => (
        <div class="set">
          <h4>{set.title}</h4>
          <ul>
            {set.supported.map((term) => (
              <li><a href={termDefinitions[term]}><code class="chip supported">{term}</code></a></li>
            ))}
            {set.unsupported.map((term) => (
              <li><a href={termDefinitions[term]}><code class="chip unsupported">{term}</code></a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</div>

<style>
  .shacl-support {
    margin-block: 1.5rem;
  }
  .shacl-support section + section {
    margin-top: 1.75rem;
  }
  .shacl-support h3 {
    font-size: var(--sl-text-h4);
    margin-bottom: 0.5rem;
  }
  .shacl-support h4 {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-2);
    margin: 0.75rem 0 0.4rem;
  }
  .shacl-support ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shacl-support .legend {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
  }
  .chip {
    display: inline-block;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: var(--sl-text-xs);
    line-height: 1.6;
    white-space: nowrap;
  }
  .chip.supported {
    background: var(--sl-color-accent-low);
    border: 1px solid var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .chip.unsupported {
    background: transparent;
    border: 1px dashed var(--sl-color-gray-5);
    color: var(--sl-color-gray-4);
  }
</style>
