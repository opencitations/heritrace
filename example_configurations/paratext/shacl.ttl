@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doco: <http://purl.org/spar/doco/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix literal: <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix oco: <https://w3id.org/oc/ontology/> .
@prefix prism: <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .

# Prefixes for the SPARQL queries in this shapes graph

[] a sh:ShapesGraph ;
  sh:declare
    [ sh:prefix "cito" ; sh:namespace "http://purl.org/spar/cito/"^^xsd:anyURI ] ,
    [ sh:prefix "datacite" ; sh:namespace "http://purl.org/spar/datacite/"^^xsd:anyURI ] ,
    [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ,
    [ sh:prefix "fabio" ; sh:namespace "http://purl.org/spar/fabio/"^^xsd:anyURI ] ,
    [ sh:prefix "foaf" ; sh:namespace "http://xmlns.com/foaf/0.1/"^^xsd:anyURI ] ,
    [ sh:prefix "frbr" ; sh:namespace "http://purl.org/vocab/frbr/core#"^^xsd:anyURI ] ,
    [ sh:prefix "literal" ; sh:namespace "http://www.essepuntato.it/2010/06/literalreification/"^^xsd:anyURI ] ,
    [ sh:prefix "prism" ; sh:namespace "http://prismstandard.org/namespaces/basic/2.0/"^^xsd:anyURI ] ,
    [ sh:prefix "pro" ; sh:namespace "http://purl.org/spar/pro/"^^xsd:anyURI ] ,
    [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

# Identifiers

schema:IdentifierShape 
  a sh:NodeShape ;
  sh:name "Identifier" ;
  sh:targetClass datacite:Identifier ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue datacite:Identifier ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path literal:hasLiteralValue ;
    sh:name "Literal Value" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:usesIdentifierScheme ;
    sh:name "Identifier Scheme" ;
    sh:order 2 ;
    sh:in (
      datacite:crossref
      datacite:datacite
      datacite:doi
      datacite:isbn
      datacite:issn
      datacite:jid
      datacite:openalex
      datacite:orcid
      datacite:pmcid
      datacite:pmid
      datacite:viaf
      datacite:wikidata
      datacite:wikipedia
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this datacite:usesIdentifierScheme ?scheme ;
                  literal:hasLiteralValue ?value .
          BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:JournalArticleIdentifierShape
  a sh:NodeShape ;
  sh:name "Identifier" ;
  sh:targetClass datacite:Identifier ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue datacite:Identifier ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:usesIdentifierScheme ;
    sh:name "Identifier Scheme" ;
    sh:order 2 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      datacite:doi
      datacite:openalex
      datacite:pmcid
      datacite:pmid
    ) ;
  ] ;
  sh:property [
    sh:path literal:hasLiteralValue ;
    sh:name "Literal Value" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:or (
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:doi ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^10\\.(\\d{4,9}|[^\\s/]+(\\.[^\\s/]+)*)/[^\\s]+$" ;
        sh:message "DOI must start with '10.' followed by a prefix, a forward slash, and a suffix. For example: 10.1162/qss_a_00023" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:pmid ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^[1-9]\\d*$" ;
        sh:message "PMID must contain only numbers. For example: 39288764" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:pmcid ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^PMC[1-9]\\d+(\\.(\\d{1,2})?)?$" ;
        sh:message "PMCID must start with 'PMC' followed by a number that doesn't start with 0, and may optionally end with a dot and 1-2 digits. For example: PMC10829861" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:openalex ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^W[1-9]\\d*$" ;
        sh:message "OpenAlex work ID must start with 'W' followed by numbers. For example: W2741809807" ;
      ] ;
    ]
  ) ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this datacite:usesIdentifierScheme ?scheme ;
                  literal:hasLiteralValue ?value .
          BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:JournalIdentifierShape
  a sh:NodeShape ;
  sh:name "Identifier" ;
  sh:targetClass datacite:Identifier ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue datacite:Identifier ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:usesIdentifierScheme ;
    sh:name "Identifier Scheme" ;
    sh:order 2 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      datacite:doi
      datacite:issn
      datacite:jid
      datacite:openalex
    ) ;
  ] ;
  sh:property [
    sh:path literal:hasLiteralValue ;
    sh:name "Literal Value" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:or (
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:issn ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^[0-9]{4}-[0-9]{3}[0-9X]$" ;
        sh:message "ISSN must be in the format NNNN-NNNC where N is a digit and C is a digit or 'X'. For example: 2641-3337" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:doi ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^10\\.(\\d{4,9}|[^\\s/]+(\\.[^\\s/]+)*)/[^\\s]+$" ;
        sh:message "DOI must start with '10.' followed by a prefix, a forward slash, and a suffix. For example: 10.1162/qss_a_00023" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:jid ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^[a-z]+([12][0-9]{3}){0,1}[a-z]*$" ;
        sh:message "JID must start with lowercase letters, optionally followed by a four-digit year, and may end with additional lowercase letters. For example: nature or science2001 or procnatacadsci" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:openalex ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^S\\d+$" ;
        sh:message "The OpenAlex journal ID must start with 'S' followed by numbers. For example: S4210195326" ;
      ] ;
    ]
  ) ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this datacite:usesIdentifierScheme ?scheme ;
                  literal:hasLiteralValue ?value .
          BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:SeriesAndProceedingsIdentifierShape
  a sh:NodeShape ;
  sh:name "Identifier" ;
  sh:targetClass datacite:Identifier ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue datacite:Identifier ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:usesIdentifierScheme ;
    sh:name "Identifier Scheme" ;
    sh:order 2 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in (
      datacite:doi
      datacite:isbn
      datacite:issn
      datacite:jid      
      datacite:openalex
    ) ;
  ] ;
  sh:property [
    sh:path literal:hasLiteralValue ;
    sh:name "Literal Value" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:or (
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:issn ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^[0-9]{4}-[0-9]{3}[0-9X]$" ;
        sh:message "ISSN must be in the format NNNN-NNNC where N is a digit and C is a digit or 'X'. For example: 2641-3337" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:doi ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^10\\.(\\d{4,9}|[^\\s/]+(\\.[^\\s/]+)*)/[^\\s]+$" ;
        sh:message "DOI must start with '10.' followed by a prefix, a forward slash, and a suffix. For example: 10.1162/qss_a_00023" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:jid ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^[a-z]+([12][0-9]{3}){0,1}[a-z]*$" ;
        sh:message "JID must start with lowercase letters, optionally followed by a four-digit year, and may end with additional lowercase letters. For example: nature or science2001 or procnatacadsci" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:openalex ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^S\\d+$" ;
        sh:message "The OpenAlex journal ID must start with 'S' followed by numbers. For example: S4210195326 " ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:isbn ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]$" ;
        sh:message "ISBN must be a valid 10 or 13-digit ISBN number, with optional hyphens. For example: 0-7475-3269-9 or 978-0-7475-3269-9" ;
      ] ;
    ]
  ) ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this datacite:usesIdentifierScheme ?scheme ;
                  literal:hasLiteralValue ?value .
          BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:BookIdentifierShape
  a sh:NodeShape ;
  sh:name "Identifier" ;
  sh:targetClass datacite:Identifier ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue datacite:Identifier ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:usesIdentifierScheme ;
    sh:name "Identifier Scheme" ;
    sh:order 2 ;
    sh:in (
      datacite:doi
      datacite:isbn
      datacite:openalex
      datacite:pmcid
      datacite:pmid
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path literal:hasLiteralValue ;
