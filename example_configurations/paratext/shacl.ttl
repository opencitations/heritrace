schema:CitationShape
  a sh:NodeShape ;
  sh:name "Citation" ;
  sh:targetClass cito:Citation ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue cito:Citation ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path cito:hasCitingEntity ;
    sh:name "Citing Entity" ;
    sh:order 2 ;
    shui:editor shui:AutoCompleteEditor ;
    sh:or (
      [ sh:node schema:ArticleShape ; sh:class fabio:Article ]
      [ sh:node schema:JournalArticleShape ; sh:class fabio:JournalArticle ]
      [ sh:node schema:BookShape ; sh:class fabio:Book ]
      [ sh:node schema:ProceedingsPaperShape ; sh:class fabio:ProceedingsPaper ]
      [ sh:node schema:ProceedingsShape ; sh:class fabio:AcademicProceedings ]
      [ sh:node schema:SpecialIssueShape ; sh:class fabio:JournalIssue ]
      [ sh:node schema:ReferenceBookShape ; sh:class fabio:ReferenceBook ]
      [ sh:node schema:ReviewShape ; sh:class fabio:Review ]
      [ sh:node schema:ReviewArticleShape ; sh:class fabio:ReviewArticle ]
      [ sh:node schema:ThesisShape ; sh:class fabio:Thesis ]
      [ sh:node schema:SeriesShape ; sh:class fabio:Series ]
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cito:hasCitedEntity ;
    sh:name "Cited Entity" ;
    sh:order 3 ;
    shui:editor shui:AutoCompleteEditor ;
    sh:or (
      [ sh:node schema:ArticleShape ; sh:class fabio:Article ]
      [ sh:node schema:JournalArticleShape ; sh:class fabio:JournalArticle ]
      [ sh:node schema:BookShape ; sh:class fabio:Book ]
      [ sh:node schema:ProceedingsPaperShape ; sh:class fabio:ProceedingsPaper ]
      [ sh:node schema:ProceedingsShape ; sh:class fabio:AcademicProceedings ]
      [ sh:node schema:SpecialIssueShape ; sh:class fabio:JournalIssue ]
      [ sh:node schema:ReferenceBookShape ; sh:class fabio:ReferenceBook ]
      [ sh:node schema:ReviewShape ; sh:class fabio:Review ]
      [ sh:node schema:ReviewArticleShape ; sh:class fabio:ReviewArticle ]
      [ sh:node schema:ThesisShape ; sh:class fabio:Thesis ]
      [ sh:node schema:SeriesShape ; sh:class fabio:Series ]
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cito:hasCitationCharacterization ;
    sh:name "Citation Type" ;
    sh:order 4 ;
    sh:or (
      [ sh:hasValue cito:reviews ]
      [ sh:hasValue cito:citesAsRelated ]
      [ sh:hasValue cito:repliesTo ]
      [ sh:hasValue cito:updates ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this cito:hasCitingEntity ?citing ;
                  cito:hasCitedEntity ?cited .

          OPTIONAL { ?citing dcterms:title ?citingTitle . }
          OPTIONAL { ?cited dcterms:title ?citedTitle . }

          BIND(CONCAT(
            "Citation from \\"",
            COALESCE(?citingTitle, STR(?citing)),
            "\\" to \\"",
            COALESCE(?citedTitle, STR(?cited)),
            "\\""
          ) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ReverseCitationShape
  a sh:NodeShape ;
  sh:name "Reverse Citation" ;
  sh:targetClass cito:Citation ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue cito:Citation ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path cito:hasCitedEntity ;
    sh:name "Cited Entity" ;
    sh:order 2 ;
    shui:editor shui:AutoCompleteEditor ;
    sh:or (
      [ sh:node schema:ArticleShape ; sh:class fabio:Article ]
      [ sh:node schema:JournalArticleShape ; sh:class fabio:JournalArticle ]
      [ sh:node schema:BookShape ; sh:class fabio:Book ]
      [ sh:node schema:ProceedingsPaperShape ; sh:class fabio:ProceedingsPaper ]
      [ sh:node schema:ProceedingsShape ; sh:class fabio:AcademicProceedings ]
      [ sh:node schema:SpecialIssueShape ; sh:class fabio:JournalIssue ]
      [ sh:node schema:ReferenceBookShape ; sh:class fabio:ReferenceBook ]
      [ sh:node schema:ReviewShape ; sh:class fabio:Review ]
      [ sh:node schema:ReviewArticleShape ; sh:class fabio:ReviewArticle ]
      [ sh:node schema:ThesisShape ; sh:class fabio:Thesis ]
      [ sh:node schema:SeriesShape ; sh:class fabio:Series ]
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cito:hasCitingEntity ;
    sh:name "Citing Entity" ;
    sh:order 3 ;
    shui:editor shui:AutoCompleteEditor ;
    sh:or (
      [ sh:node schema:ArticleShape ; sh:class fabio:Article ]
      [ sh:node schema:JournalArticleShape ; sh:class fabio:JournalArticle ]
      [ sh:node schema:BookShape ; sh:class fabio:Book ]
      [ sh:node schema:ProceedingsPaperShape ; sh:class fabio:ProceedingsPaper ]
      [ sh:node schema:ProceedingsShape ; sh:class fabio:AcademicProceedings ]
      [ sh:node schema:SpecialIssueShape ; sh:class fabio:JournalIssue ]
      [ sh:node schema:ReferenceBookShape ; sh:class fabio:ReferenceBook ]
      [ sh:node schema:ReviewShape ; sh:class fabio:Review ]
      [ sh:node schema:ReviewArticleShape ; sh:class fabio:ReviewArticle ]
      [ sh:node schema:ThesisShape ; sh:class fabio:Thesis ]
      [ sh:node schema:SeriesShape ; sh:class fabio:Series ]
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cito:hasCitationCharacterization ;
    sh:name "Citation Type" ;
    sh:order 4 ;
    sh:or (
      [ sh:hasValue cito:isReviewedBy ]
      [ sh:hasValue cito:isCitedAsRelatedBy ]
      [ sh:hasValue cito:hasReplyFrom ]
      [ sh:hasValue cito:isUpdatedBy ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this cito:hasCitingEntity ?citing ;
                  cito:hasCitedEntity ?cited .

          OPTIONAL { ?citing dcterms:title ?citingTitle . }
          OPTIONAL { ?cited dcterms:title ?citedTitle . }

          BIND(CONCAT(
            "Citation from \\"",
            COALESCE(?citingTitle, STR(?citing)),
            "\\" to \\"",
            COALESCE(?citedTitle, STR(?cited)),
            "\\""
          ) AS ?display)
        }
      """ ;
    ] ;
  ] .