                IF(STRSTARTS(?uriString, "https://w3id.org/oc/meta/") && STRLEN(?omid) > 0, CONCAT(?nameDisplay, " [omid:", ?omid, " ", ?identifiers, "]"), CONCAT(?nameDisplay, " [", ?identifiers, "]")),
                IF(STRSTARTS(?uriString, "https://w3id.org/oc/meta/") && STRLEN(?omid) > 0, CONCAT(?nameDisplay, " [omid:", ?omid, "]"), ?nameDisplay)
            ) AS ?formattedName)
