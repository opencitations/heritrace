schema:AgentIdentifierShape
  a sh:NodeShape ;
  sh:name "Identifier"@en, "Identificativo"@it ;
  sh:targetClass datacite:Identifier ;
  dash:hidden true ;
  owl:hasKey
    ( literal:hasLiteralValue datacite:usesIdentifierScheme ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue datacite:Identifier ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path literal:hasLiteralValue ;
    sh:name "Literal value"@en, "Valore letterale"@it ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:usesIdentifierScheme ;
    sh:name "Identifier scheme"@en, "Schema dell'identificativo"@it ;
    sh:order 2 ;
    sh:in (
      datacite:crossref
      datacite:orcid
      datacite:ror
      datacite:viaf
      datacite:wikidata
      datacite:wikipedia
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:or (
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:orcid ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^([0-9]{4}-){3}[0-9]{3}[0-9X]$" ;
        sh:message "ORCID must be in the format 'XXXX-XXXX-XXXX-XXXX' where X is a digit or 'X'. For example: 0000-0002-1825-0097"@en, "L'ORCID deve avere il formato 'XXXX-XXXX-XXXX-XXXX', dove X è una cifra o 'X'. Per esempio: 0000-0002-1825-0097"@it ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:viaf ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^[1-9]\\d{1,21}$" ;
        sh:message "VIAF ID must be a string of 2 to 22 digits, not starting with 0. For example: 12345678"@en, "L'ID VIAF deve essere una sequenza da 2 a 22 cifre che non inizia con 0. Per esempio: 12345678"@it ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:crossref ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^\\d+$" ;
        sh:message "Crossref ID must be a string of one or more digits. For example: 98765432"@en, "L'ID Crossref deve essere una sequenza di una o più cifre. Per esempio: 98765432"@it ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:wikidata ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^Q[1-9]\\d*$" ;
        sh:message "Wikidata ID must start with 'Q' followed by a non-zero digit and optionally more digits. For example: Q42"@en, "L'ID Wikidata deve iniziare con 'Q' seguita da una cifra diversa da zero e, facoltativamente, da altre cifre. Per esempio: Q42"@it ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:wikipedia ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^[1-9][0-9]*$" ;
        sh:message "Wikipedia ID must be a string of digits not starting with 0. For example: 123456"@en, "L'ID Wikipedia deve essere una sequenza di cifre che non inizia con 0. Per esempio: 123456"@it ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:ror ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^((https:\\/\\/)?ror\\.org\\/)?0[a-hj-km-np-tv-z|0-9]{6}[0-9]{2}$" ;
        sh:message "ROR ID must be in the format '0XXXXXXXX' where X is a digit or lowercase letter (excluding i, l, o), optionally prefixed with 'https://ror.org/'. For example: 04wxnsj81 or https://ror.org/04wxnsj81"@en, "L'ID ROR deve avere il formato '0XXXXXXXX', dove X è una cifra o una lettera minuscola (escluse i, l, o), eventualmente preceduto da 'https://ror.org/'. Per esempio: 04wxnsj81 o https://ror.org/04wxnsj81"@it ;
      ] ;
    ]
  ) ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this datacite:usesIdentifierScheme ?scheme ;
                  literal:hasLiteralValue ?value .
          BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?display)
        }
      """ ;
    ] ;
  ] .

# Agent roles

schema:AgentRoleShape
  a sh:NodeShape ;
  sh:name "Agent role"@en, "Ruolo dell'agente"@it ;
  sh:targetClass pro:RoleInTime ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue pro:RoleInTime ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path oco:hasNext ;
    dash:hidden true ;
    sh:name "Has next"@en, "Successivo"@it ;
    sh:order 3 ;
    sh:node schema:AgentRoleShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isHeldBy ;
    sh:name "Held by"@en, "Ricoperto da"@it ;
    sh:order 2 ;
    sh:node schema:ResponsibleAgentShape ;
    sh:class foaf:Agent ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:withRole ;
    sh:name "Role"@en, "Ruolo"@it ;
    sh:order 4 ;
    sh:in (pro:publisher pro:author pro:editor) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this pro:withRole ?role ;
                  pro:isHeldBy ?agent .
          OPTIONAL { ?agent foaf:name ?name. }
          OPTIONAL { ?agent foaf:familyName ?familyName. }
          OPTIONAL { ?agent foaf:givenName ?givenName. }
          BIND(
              IF(BOUND(?name), ?name,
                  IF(BOUND(?familyName) && BOUND(?givenName), 
                      CONCAT(?familyName, ", ", ?givenName),
                      IF(BOUND(?familyName), ?familyName, 
                          IF(BOUND(?givenName), ?givenName, STR(?agent))
                      )
                  )
              ) AS ?agentDisplay
          )
          BIND(
            IF($language = "it",
              IF(?role = pro:author, "autore",
              IF(?role = pro:editor, "curatore",
              IF(?role = pro:publisher, "editore",
              STRAFTER(STR(?role), "pro/")))),
              STRAFTER(STR(?role), "pro/")
            ) AS ?roleName
          )
          BIND(CONCAT(?roleName, ": ", ?agentDisplay) AS ?display)
        }
      """ ;
    ] ;
  ]
  .

# Bibliographic resources

schema:ExpressionShape
  a sh:NodeShape ;
  sh:name "Bibliographic resource"@en, "Risorsa bibliografica"@it ;
  sh:targetClass fabio:Expression ;
  dash:hidden true ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [
      sh:or (
        [ sh:hasValue fabio:JournalArticle ]
        [ sh:hasValue fabio:Book ]
        [ sh:hasValue fabio:ProceedingsPaper ]
        [ sh:hasValue fabio:AcademicProceedings ]
        [ sh:hasValue fabio:Journal ]
        [ sh:hasValue fabio:JournalVolume ]
        [ sh:hasValue fabio:JournalIssue ]
        [ sh:hasValue fabio:ReferenceBook ]
        [ sh:hasValue fabio:Thesis ]
      )
    ] ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier"@en, "Identificativo"@it ;
    sh:order 2 ;
    sh:node schema:IdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication date"@en, "Data di pubblicazione"@it ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:embodiment ;
    dash:composite true ;
    sh:name "Page"@en, "Pagina"@it ;
    sh:order 8 ;
    sh:node schema:ResourceEmbodimentShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:withRole ] , [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:order 6 ;
    sh:node schema:AgentRoleShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Part of"@en, "Parte di"@it ;
    sh:order 9 ;
    sh:node schema:BibliographicResourceShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?entityType ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage ?bookTitle ?proceedingsTitle
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
            WHERE {
              {
                SELECT * WHERE {
                  $this a fabio:Expression .
                  OPTIONAL { 
                    $this a ?specificType .
                    FILTER(?specificType != fabio:Expression)
                  }
                  BIND(COALESCE(?specificType, fabio:Expression) AS ?entityType)

                  OPTIONAL { $this dcterms:title ?title . }

                  # Authors (not applicable for Journal, Volume, Issue)
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?authorRole .
                    ?authorRole pro:withRole pro:author ;
                                pro:isHeldBy ?author .
                    {
                      SELECT ?authorRole (COUNT(?previousAuthorRole) AS ?authorPosition)
                      WHERE {
                        $this pro:isDocumentContextFor ?authorRole, ?previousAuthorRole .
                        ?authorRole pro:withRole pro:author .
                        ?previousAuthorRole <https://w3id.org/oc/ontology/hasNext>* ?authorRole .
                      }
                      GROUP BY ?authorRole
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:name ?candidateAuthorName .
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:familyName ?familyName .
                      OPTIONAL {
                        $this pro:isDocumentContextFor ?authorRole .
                        ?authorRole pro:withRole pro:author ;
                                    pro:isHeldBy ?author .
                        ?author foaf:givenName ?givenName .
                      }
                      BIND(CONCAT(?familyName, COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")) AS ?candidateAuthorName)
                    }
                  }
                  BIND(IF(?entityType NOT IN (fabio:JournalVolume, fabio:JournalIssue), ?candidateAuthorName, ?unboundAuthorName) AS ?authorName)

                  # Publication Date
                  OPTIONAL {
                    $this prism:publicationDate ?pubDateRaw . 
                    BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, STR(?pubDateRaw),
                        IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), SUBSTR(STR(?pubDateRaw), 1, 4),
                        STR(?pubDateRaw))) AS ?pubDate)
                  }

                  # Journal Article, Volume, and Issue specific info
                  OPTIONAL {
                    {
                      $this frbr:partOf ?journal .
                      ?journal a fabio:Journal ;
                              dcterms:title ?journalTitle .
                    }
                    UNION
                    {
                      $this frbr:partOf ?volume .
                      ?volume a fabio:JournalVolume ;
                              fabio:hasSequenceIdentifier ?volumeNumber ;
                              frbr:partOf ?journal .
                      ?journal a fabio:Journal ;
                              dcterms:title ?journalTitle .
                    }
                    UNION
                    {
                      $this frbr:partOf ?issue .
                      ?issue a fabio:JournalIssue ;
                            fabio:hasSequenceIdentifier ?issueNumber ;
                            frbr:partOf ?volume .
                      ?volume a fabio:JournalVolume ;
                              fabio:hasSequenceIdentifier ?volumeNumber ;
                              frbr:partOf ?journal .
                      ?journal a fabio:Journal ;
                              dcterms:title ?journalTitle .
                    }
                  }

                  # Book Chapter specific info
                  OPTIONAL {
                    $this frbr:partOf ?book .
                    ?book a fabio:Book ;
                          dcterms:title ?candidateBookTitle .
                  }
                  BIND(IF(?entityType IN (fabio:BookChapter, fabio:Expression), ?candidateBookTitle, ?unboundBookTitle) AS ?bookTitle)

                  # Proceedings Paper specific info
                  OPTIONAL {
                    $this frbr:partOf ?proceedings .
                    ?proceedings a fabio:AcademicProceedings ;
                                dcterms:title ?candidateProceedingsTitle .
                  }
                  BIND(IF(?entityType IN (fabio:ProceedingsPaper, fabio:Expression), ?candidateProceedingsTitle, ?unboundProceedingsTitle) AS ?proceedingsTitle)

                  # Page information
                  OPTIONAL {
                    $this frbr:embodiment ?embodiment .
                    OPTIONAL { ?embodiment prism:startingPage ?startPage . }
                    OPTIONAL { ?embodiment prism:endingPage ?endPage . }
                  }
                }
                ORDER BY ?authorPosition
              }
            }
            GROUP BY ?entityType ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage ?bookTitle ?proceedingsTitle
          }

          # Construct the display string based on entity type
          BIND(
            IF(?entityType IN (fabio:JournalArticle, fabio:Expression), 
              CONCAT(COALESCE(?authorList, ""),
                    IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                    IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                    IF(BOUND(?title), CONCAT(". ", ?title), ""),
                    IF(BOUND(?journalTitle), CONCAT(". ", ?journalTitle), ""),
                    IF(BOUND(?volumeNumber), CONCAT(", ", ?volumeNumber), ""),
                    IF(BOUND(?issueNumber), CONCAT("(", ?issueNumber, ")"), ""),
                    IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
                    COALESCE(?startPage, ""),
                    IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
                    COALESCE(?endPage, ""),
                    "."),
            IF(?entityType IN (fabio:BookChapter, fabio:Expression),
              CONCAT(COALESCE(?authorList, ""),
                    IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                    IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                    IF(BOUND(?title), CONCAT(". ", ?title), ""),
                    IF(BOUND(?bookTitle), CONCAT(". In: ", ?bookTitle), ""),
                    IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
                    COALESCE(?startPage, ""),
                    IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
                    COALESCE(?endPage, ""),
                    "."),
            IF(?entityType IN (fabio:ProceedingsPaper, fabio:Expression),
              CONCAT(COALESCE(?authorList, ""),
                    IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                    IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                    IF(BOUND(?title), CONCAT(". ", ?title), ""),
                    IF(BOUND(?proceedingsTitle), CONCAT(". In: ", ?proceedingsTitle), ""),
                    IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
                    COALESCE(?startPage, ""),
                    IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
                    COALESCE(?endPage, ""),
                    "."),
            IF(?entityType IN (fabio:Book, fabio:Expression),
              CONCAT(COALESCE(?authorList, ""),
                    IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                    IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                    IF(BOUND(?title), CONCAT(". ", ?title), ""),
                    "."),
            IF(?entityType IN (fabio:AcademicProceedings, fabio:Expression),
              CONCAT(IF(BOUND(?title), ?title, ""),
                    IF(BOUND(?pubDate), CONCAT(" (", ?pubDate, ")"), ""),
                    "."),
            IF(?entityType IN (fabio:JournalVolume, fabio:Expression),
              CONCAT("Volume ", ?volumeNumber,
                    IF(BOUND(?journalTitle), CONCAT(IF($language = "it", " di ", " of "), ?journalTitle), ""),
                    "."),
            IF(?entityType IN (fabio:JournalIssue, fabio:Expression),
              CONCAT(IF($language = "it", "Fascicolo ", "Issue "), ?issueNumber,
                    IF(BOUND(?volumeNumber), CONCAT(IF($language = "it", " del volume ", " of volume "), ?volumeNumber), ""),
                    IF(BOUND(?journalTitle), CONCAT(", ", ?journalTitle), ""),
                    "."),
            IF(?entityType = fabio:Journal,
              CONCAT(?title,
                    IF(BOUND(?pubDate), CONCAT(" (", ?pubDate, ")"), ""),
                    "."),
            IF($language = "it", "Tipo di risorsa sconosciuto.", "Unknown entity type.")
          )))))))) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:JournalArticleShape
  a sh:NodeShape ;
  sh:name "Journal article"@en, "Articolo di rivista"@it ;
  sh:targetClass fabio:JournalArticle ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier"@en, "Identificativo"@it ;
    sh:order 2 ;
    sh:node schema:JournalArticleIdentifierShape ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:JournalArticle ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Container"@en, "Contenitore"@it ;
    sh:order 9 ;
    shui:editor shui:AutoCompleteEditor ;
    sh:or (
      [ sh:node schema:IssueShape ; sh:class fabio:JournalIssue ]
      [ sh:node schema:VolumeShape ; sh:class fabio:JournalVolume ]
      [ sh:node schema:JournalShape ; sh:class fabio:Journal ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication date"@en, "Data di pubblicazione"@it ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:embodiment ;
    dash:composite true ;
    sh:name "Page"@en, "Pagina"@it ;
    sh:order 8 ;
    sh:node schema:ResourceEmbodimentShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author"@en, "Autore"@it ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor"@en, "Curatore"@it ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher"@en, "Editore"@it ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
            WHERE {
              {
                SELECT * WHERE {
                  $this a fabio:JournalArticle .
                  OPTIONAL { $this dcterms:title ?title . }
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?authorRole .
                    ?authorRole pro:withRole pro:author ;
                                pro:isHeldBy ?author .
                    {
                      SELECT ?authorRole (COUNT(?previousAuthorRole) AS ?authorPosition)
                      WHERE {
                        $this pro:isDocumentContextFor ?authorRole, ?previousAuthorRole .
                        ?authorRole pro:withRole pro:author .
                        ?previousAuthorRole <https://w3id.org/oc/ontology/hasNext>* ?authorRole .
                      }
                      GROUP BY ?authorRole
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:name ?authorName .
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:familyName ?familyName .
                      OPTIONAL {
                        $this pro:isDocumentContextFor ?authorRole .
                        ?authorRole pro:withRole pro:author ;
                                    pro:isHeldBy ?author .
                        ?author foaf:givenName ?givenName .
                      }
                      BIND(CONCAT(
                        ?familyName,
                        COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                      ) AS ?authorName)
                    }
                  }
                  OPTIONAL {
                    $this prism:publicationDate ?pubDateRaw . 
                    BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                            STR(?pubDateRaw),
                            IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                              SUBSTR(STR(?pubDateRaw), 1, 4),
                              STR(?pubDateRaw))) AS ?pubDate)
                  }
                  OPTIONAL {
                    $this frbr:partOf ?issue .
                    ?issue a fabio:JournalIssue ;
                          frbr:partOf ?volume .
                    ?volume a fabio:JournalVolume ;
                            fabio:hasSequenceIdentifier ?volumeNumber ;
                            frbr:partOf ?journal .
                    ?journal dcterms:title ?journalTitle .
                    OPTIONAL { ?issue fabio:hasSequenceIdentifier ?issueNumber . }
                  }
                  OPTIONAL {
                    $this frbr:embodiment ?embodiment .
                    OPTIONAL { ?embodiment prism:startingPage ?startPage . }
                    OPTIONAL { ?embodiment prism:endingPage ?endPage . }
                  }
                }
                ORDER BY ?authorPosition
              }
            }
            GROUP BY ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage
          }

          BIND(CONCAT(
            COALESCE(?authorList, ""),
            IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
            IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
            IF(BOUND(?title), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
              ?title
            ), ""),
            IF(BOUND(?journalTitle), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". ", ""),
              ?journalTitle
            ), ""),
            IF(BOUND(?volumeNumber), CONCAT(", ", ?volumeNumber), ""),
            IF(BOUND(?issueNumber), CONCAT("(", ?issueNumber, ")"), ""),
            IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
            COALESCE(?startPage, ""),
            IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
            COALESCE(?endPage, ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:BookShape
  a sh:NodeShape ;
  sh:name "Monograph"@en, "Monografia"@it ;
  sh:targetClass fabio:Book ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier"@en, "Identificativo"@it ;
    sh:order 2 ;
    sh:node schema:BookIdentifierShape ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Book ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication date"@en, "Data di pubblicazione"@it ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author"@en, "Autore"@it ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor"@en, "Curatore"@it ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher"@en, "Editore"@it ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?publisher
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
                  (GROUP_CONCAT(?editorName; SEPARATOR = ", ") AS ?editorList)
            WHERE {
              {
                SELECT * WHERE {
                  $this a fabio:Book .
                  OPTIONAL { $this dcterms:title ?title . }

                  # Get author information
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?authorRole .
                    ?authorRole pro:withRole pro:author ;
                                pro:isHeldBy ?author .
                    {
                      SELECT ?authorRole (COUNT(?previousAuthorRole) AS ?authorPosition)
                      WHERE {
                        $this pro:isDocumentContextFor ?authorRole, ?previousAuthorRole .
                        ?authorRole pro:withRole pro:author .
                        ?previousAuthorRole <https://w3id.org/oc/ontology/hasNext>* ?authorRole .
                      }
                      GROUP BY ?authorRole
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:name ?authorName .
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:familyName ?familyName .
                      OPTIONAL {
                        $this pro:isDocumentContextFor ?authorRole .
                        ?authorRole pro:withRole pro:author ;
                                    pro:isHeldBy ?author .
                        ?author foaf:givenName ?givenName .
                      }
                      BIND(CONCAT(
                        ?familyName,
                        COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                      ) AS ?authorName)
                    }
                  }

                  # Get editor information
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?editorRole .
                    ?editorRole pro:withRole pro:editor ;
                                pro:isHeldBy ?editor .
                    {
                      SELECT ?editorRole (COUNT(?previousEditorRole) AS ?editorPosition)
                      WHERE {
                        $this pro:isDocumentContextFor ?editorRole, ?previousEditorRole .
                        ?editorRole pro:withRole pro:editor .
                        ?previousEditorRole <https://w3id.org/oc/ontology/hasNext>* ?editorRole .
                      }
                      GROUP BY ?editorRole
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?editorRole .
                      ?editorRole pro:withRole pro:editor ;
                                  pro:isHeldBy ?editor .
                      ?editor foaf:name ?editorName .
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?editorRole .
                      ?editorRole pro:withRole pro:editor ;
                                  pro:isHeldBy ?editor .
                      ?editor foaf:familyName ?familyName .
                      OPTIONAL {
                        $this pro:isDocumentContextFor ?editorRole .
                        ?editorRole pro:withRole pro:editor ;
                                    pro:isHeldBy ?editor .
                        ?editor foaf:givenName ?givenName .
                      }
                      BIND(CONCAT(
                        ?familyName,
                        COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                      ) AS ?editorName)
                    }
                  }

                  # Get publication date
                  OPTIONAL {
                    $this prism:publicationDate ?pubDateRaw . 
                    BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                            STR(?pubDateRaw),
                            IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                              SUBSTR(STR(?pubDateRaw), 1, 4),
                              STR(?pubDateRaw))) AS ?pubDate)
                  }

                  # Get publisher information
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?publisherRole .
                    ?publisherRole pro:withRole pro:publisher ;
                                  pro:isHeldBy ?publisherAgent .
                    ?publisherAgent foaf:name ?publisher .
                  }
                }
                ORDER BY ?authorPosition ?editorPosition
              }
            }
            GROUP BY ?title ?pubDate ?publisher
          }

          # Construct the display string based on available information
          BIND(
            IF(BOUND(?editorList) && (!BOUND(?authorList) || ?authorList = ""),
              # Case 1: Only editors
              CONCAT(
                ?editorList, IF($language = "it", " (cur.)", " (Ed.)"),
                IF(BOUND(?pubDate), CONCAT(" (", ?pubDate, ")"), ""),
                IF(BOUND(?title), CONCAT(". ", ?title), ""),
                IF(BOUND(?publisher), CONCAT(". ", ?publisher), ""),
                "."
              ),
              # Case 2: Authors (with or without editors)
              CONCAT(
                COALESCE(?authorList, ""),
                IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                IF(BOUND(?title), CONCAT(". ", ?title), ""),
                IF(BOUND(?editorList), CONCAT(". ", ?editorList, IF($language = "it", " (cur.)", " (Ed.)")), ""),
                IF(BOUND(?publisher), CONCAT(". ", ?publisher), ""),
                "."
              )
            ) AS ?displayWithDot
          )

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ProceedingsPaperShape
  a sh:NodeShape ;
  sh:name "Proceedings paper"@en, "Contributo in atti di convegno"@it ;
  sh:targetClass fabio:ProceedingsPaper ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:ProceedingsPaper ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Conference proceedings"@en, "Atti di convegno"@it ;
    sh:order 9 ;
    sh:node schema:ProceedingsShape ;
    sh:class fabio:AcademicProceedings ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication date"@en, "Data di pubblicazione"@it ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:embodiment ;
    dash:composite true ;
    sh:name "Page"@en, "Pagina"@it ;
    sh:order 8 ;
    sh:node schema:ResourceEmbodimentShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author"@en, "Autore"@it ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor"@en, "Curatore"@it ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher"@en, "Editore"@it ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier"@en, "Identificativo"@it ;
    sh:order 2 ;
    sh:node schema:JournalArticleIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?proceedingsTitle
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
            WHERE {
              {
                SELECT * WHERE {
                  $this a fabio:ProceedingsPaper .
                  OPTIONAL { $this dcterms:title ?title . }
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?authorRole .
                    ?authorRole pro:withRole pro:author ;
                                pro:isHeldBy ?author .
                    {
                      SELECT ?authorRole (COUNT(?previousAuthorRole) AS ?authorPosition)
                      WHERE {
                        $this pro:isDocumentContextFor ?authorRole, ?previousAuthorRole .
                        ?authorRole pro:withRole pro:author .
                        ?previousAuthorRole <https://w3id.org/oc/ontology/hasNext>* ?authorRole .
                      }
                      GROUP BY ?authorRole
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:name ?authorName .
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:familyName ?familyName .
                      OPTIONAL {
                        $this pro:isDocumentContextFor ?authorRole .
                        ?authorRole pro:withRole pro:author ;
                                    pro:isHeldBy ?author .
                        ?author foaf:givenName ?givenName .
                      }
                      BIND(CONCAT(
                        ?familyName,
                        COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                      ) AS ?authorName)
                    }
                  }
                  OPTIONAL {
                    $this prism:publicationDate ?pubDateRaw . 
                    BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                            STR(?pubDateRaw),
                            IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                              SUBSTR(STR(?pubDateRaw), 1, 4),
                              STR(?pubDateRaw))) AS ?pubDate)
                  }
                  OPTIONAL {
                    $this frbr:partOf ?proceedings .
                    ?proceedings a fabio:AcademicProceedings ;
                                dcterms:title ?proceedingsTitle .
                  }
                }
                ORDER BY ?authorPosition
              }
            }
            GROUP BY ?title ?pubDate ?proceedingsTitle
          }

          BIND(CONCAT(
            COALESCE(?authorList, ""),
            IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
            IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
            IF(BOUND(?title), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
              ?title
            ), ""),
            IF(BOUND(?proceedingsTitle), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". In: ", "In: "),
              ?proceedingsTitle
            ), ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ProceedingsShape
  a sh:NodeShape ;
  sh:name "Proceedings"@en, "Atti"@it ;
  sh:targetClass fabio:AcademicProceedings ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:AcademicProceedings ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication date"@en, "Data di pubblicazione"@it ;
    sh:order 6 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor"@en, "Curatore"@it ;
    sh:order 4 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher"@en, "Editore"@it ;
    sh:order 5 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier"@en, "Identificativo"@it ;
    sh:order 2 ;
    sh:node schema:SeriesAndProceedingsIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this a fabio:AcademicProceedings ;
                  dcterms:title ?title .
          OPTIONAL {
            $this prism:publicationDate ?pubDateRaw . 
            BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                    STR(?pubDateRaw),
                    IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                      SUBSTR(STR(?pubDateRaw), 1, 4),
                      STR(?pubDateRaw))) AS ?pubDate)
          }
          OPTIONAL {
            SELECT (GROUP_CONCAT(?editorName; SEPARATOR = ", ") AS ?editorList)
            WHERE {
              {
                SELECT * WHERE {
                  $this pro:isDocumentContextFor ?editorRole .
                  ?editorRole pro:withRole pro:editor ;
                              pro:isHeldBy ?editor .
                  {
                    SELECT ?editorRole (COUNT(?previousEditorRole) AS ?editorPosition)
                    WHERE {
                      $this pro:isDocumentContextFor ?editorRole, ?previousEditorRole .
                      ?editorRole pro:withRole pro:editor .
                      ?previousEditorRole <https://w3id.org/oc/ontology/hasNext>* ?editorRole .
                    }
                    GROUP BY ?editorRole
                  }
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?editorRole .
                    ?editorRole pro:withRole pro:editor ;
                                pro:isHeldBy ?editor .
                    ?editor foaf:name ?editorName .
                  }
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?editorRole .
                    ?editorRole pro:withRole pro:editor ;
                                pro:isHeldBy ?editor .
                    ?editor foaf:familyName ?familyName .
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?editorRole .
                      ?editorRole pro:withRole pro:editor ;
                                  pro:isHeldBy ?editor .
                      ?editor foaf:givenName ?givenName .
                    }
                    BIND(CONCAT(
                      ?familyName,
                      COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                    ) AS ?editorName)
                  }
                }
                ORDER BY ?editorPosition
              }
            }
          }

          BIND(CONCAT(
            ?title,
            IF(BOUND(?editorList) && STRLEN(?editorList) > 0, CONCAT(". ", ?editorList, IF($language = "it", " (cur.)", " (Ed.)")), ""),
            IF(BOUND(?pubDate), CONCAT(" (", ?pubDate, ")"), ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:JournalShape
  a sh:NodeShape ;
  sh:name "Journal"@en, "Rivista"@it ;
  sh:targetClass fabio:Journal ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Journal ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier"@en, "Identificativo"@it ;
    sh:order 2 ;
    sh:node schema:JournalIdentifierShape ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              $this dcterms:title ?title .

              # Get all identifiers
              OPTIONAL {
                $this datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                          literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
            }
            GROUP BY ?title
          }

          # Format display string with OMID and identifiers
          BIND(STR($this) AS ?uriString)
          BIND(STRAFTER(?uriString, "https://w3id.org/oc/meta/") AS ?omid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                IF(STRSTARTS(?uriString, "https://w3id.org/oc/meta/") && STRLEN(?omid) > 0, CONCAT(?title, " [omid:", ?omid, " ", ?identifiers, "]"), CONCAT(?title, " [", ?identifiers, "]")),
                IF(STRSTARTS(?uriString, "https://w3id.org/oc/meta/") && STRLEN(?omid) > 0, CONCAT(?title, " [omid:", ?omid, "]"), ?title)
              ) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:VolumeShape
  a sh:NodeShape ;
  sh:name "Volume"@en, "Volume"@it ;
  sh:targetClass fabio:JournalVolume ;
  owl:hasKey
    ( fabio:hasSequenceIdentifier frbr:partOf ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:JournalVolume ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path fabio:hasSequenceIdentifier ;
    sh:name "Number"@en, "Numero"@it ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Journal"@en, "Rivista"@it ;
    sh:order 3 ;
    sh:node schema:JournalShape ;
    sh:class fabio:Journal ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this fabio:hasSequenceIdentifier ?volumeNumber .
          OPTIONAL {
            $this frbr:partOf ?journal .
            ?journal a fabio:Journal ;
                     dcterms:title ?journalTitle .
            OPTIONAL {
              SELECT ?journal (GROUP_CONCAT(?idString; separator=" ") AS ?journalIdentifiers)
              WHERE {
                $this frbr:partOf ?journal .
                ?journal datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                            literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
              GROUP BY ?journal
            }
            BIND(STR(?journal) AS ?journalUriString)
            BIND(STRAFTER(?journalUriString, "https://w3id.org/oc/meta/") AS ?journalOmid)
            BIND(IF(BOUND(?journalIdentifiers) && STRLEN(?journalIdentifiers) > 0,
                  IF(STRSTARTS(?journalUriString, "https://w3id.org/oc/meta/") && STRLEN(?journalOmid) > 0,
                    CONCAT(?journalTitle, " [omid:", ?journalOmid, " ", ?journalIdentifiers, "]"),
                    CONCAT(?journalTitle, " [", ?journalIdentifiers, "]")),
                  IF(STRSTARTS(?journalUriString, "https://w3id.org/oc/meta/") && STRLEN(?journalOmid) > 0,
                    CONCAT(?journalTitle, " [omid:", ?journalOmid, "]"),
                    ?journalTitle)
                ) AS ?journalDisplay)
          }
          BIND(IF(BOUND(?journalDisplay),
            CONCAT("Vol. ", ?volumeNumber, ", ", ?journalDisplay),
            CONCAT("Vol. ", ?volumeNumber)) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:IssueShape
  a sh:NodeShape ;
  sh:name "Issue"@en, "Fascicolo"@it ;
  sh:targetClass fabio:JournalIssue ;
  owl:hasKey
    ( fabio:hasSequenceIdentifier frbr:partOf ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:JournalIssue ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path fabio:hasSequenceIdentifier ;
    sh:name "Number"@en, "Numero"@it ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Container"@en, "Contenitore"@it ;
    sh:order 3 ;
    shui:editor shui:AutoCompleteEditor ;
    sh:or (
      [ sh:node schema:VolumeShape ; sh:class fabio:JournalVolume ]
      [ sh:node schema:JournalShape ; sh:class fabio:Journal ]
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this fabio:hasSequenceIdentifier ?issueNumber .
          OPTIONAL {
            $this frbr:partOf ?volume .
            ?volume a fabio:JournalVolume ;
                    fabio:hasSequenceIdentifier ?volumeNumber .
          }
          OPTIONAL {
            $this frbr:partOf/frbr:partOf? ?journal .
            ?journal a fabio:Journal ;
                     dcterms:title ?journalTitle .
            OPTIONAL {
              SELECT ?journal (GROUP_CONCAT(?idString; separator=" ") AS ?journalIdentifiers)
              WHERE {
                $this frbr:partOf/frbr:partOf? ?journal .
                ?journal datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                            literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
              GROUP BY ?journal
            }
            BIND(STR(?journal) AS ?journalUriString)
            BIND(STRAFTER(?journalUriString, "https://w3id.org/oc/meta/") AS ?journalOmid)
            BIND(IF(BOUND(?journalIdentifiers) && STRLEN(?journalIdentifiers) > 0,
                  IF(STRSTARTS(?journalUriString, "https://w3id.org/oc/meta/") && STRLEN(?journalOmid) > 0,
                    CONCAT(?journalTitle, " [omid:", ?journalOmid, " ", ?journalIdentifiers, "]"),
                    CONCAT(?journalTitle, " [", ?journalIdentifiers, "]")),
                  IF(STRSTARTS(?journalUriString, "https://w3id.org/oc/meta/") && STRLEN(?journalOmid) > 0,
                    CONCAT(?journalTitle, " [omid:", ?journalOmid, "]"),
                    ?journalTitle)
                ) AS ?journalDisplay)
          }
          BIND(CONCAT(
            IF($language = "it", "Fascicolo ", "Issue "), ?issueNumber,
            IF(BOUND(?volumeNumber), CONCAT(", Vol. ", ?volumeNumber), ""),
            IF(BOUND(?journalDisplay), CONCAT(", ", ?journalDisplay), "")
          ) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ReferenceBookShape
  a sh:NodeShape ;
  sh:name "Dictionary"@en, "Dizionario"@it ;
  sh:targetClass fabio:ReferenceBook ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:ReferenceBook ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication date"@en, "Data di pubblicazione"@it ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author"@en, "Autore"@it ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor"@en, "Curatore"@it ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher"@en, "Editore"@it ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier"@en, "Identificativo"@it ;
    sh:order 2 ;
    sh:node schema:BookIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?publisher ?edition
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
                  (GROUP_CONCAT(?editorName; SEPARATOR = ", ") AS ?editorList)
            WHERE {
              {
                SELECT * WHERE {
                  $this a fabio:ReferenceBook .
                  OPTIONAL { $this dcterms:title ?title . }

                  # Get author information
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?authorRole .
                    ?authorRole pro:withRole pro:author ;
                                pro:isHeldBy ?author .
                    {
                      SELECT ?authorRole (COUNT(?previousAuthorRole) AS ?authorPosition)
                      WHERE {
                        $this pro:isDocumentContextFor ?authorRole, ?previousAuthorRole .
                        ?authorRole pro:withRole pro:author .
                        ?previousAuthorRole <https://w3id.org/oc/ontology/hasNext>* ?authorRole .
                      }
                      GROUP BY ?authorRole
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:name ?authorName .
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:familyName ?familyName .
                      OPTIONAL {
                        $this pro:isDocumentContextFor ?authorRole .
                        ?authorRole pro:withRole pro:author ;
                                    pro:isHeldBy ?author .
                        ?author foaf:givenName ?givenName .
                      }
                      BIND(CONCAT(
                        ?familyName,
                        COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                      ) AS ?authorName)
                    }
                  }

                  # Get editor information
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?editorRole .
                    ?editorRole pro:withRole pro:editor ;
                                pro:isHeldBy ?editor .
                    {
                      SELECT ?editorRole (COUNT(?previousEditorRole) AS ?editorPosition)
                      WHERE {
                        $this pro:isDocumentContextFor ?editorRole, ?previousEditorRole .
                        ?editorRole pro:withRole pro:editor .
                        ?previousEditorRole <https://w3id.org/oc/ontology/hasNext>* ?editorRole .
                      }
                      GROUP BY ?editorRole
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?editorRole .
                      ?editorRole pro:withRole pro:editor ;
                                  pro:isHeldBy ?editor .
                      ?editor foaf:name ?editorName .
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?editorRole .
                      ?editorRole pro:withRole pro:editor ;
                                  pro:isHeldBy ?editor .
                      ?editor foaf:familyName ?familyName .
                      OPTIONAL {
                        $this pro:isDocumentContextFor ?editorRole .
                        ?editorRole pro:withRole pro:editor ;
                                    pro:isHeldBy ?editor .
                        ?editor foaf:givenName ?givenName .
                      }
                      BIND(CONCAT(
                        ?familyName,
                        COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                      ) AS ?editorName)
                    }
                  }

                  # Get publication date
                  OPTIONAL {
                    $this prism:publicationDate ?pubDateRaw . 
                    BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                            STR(?pubDateRaw),
                            IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                              SUBSTR(STR(?pubDateRaw), 1, 4),
                              STR(?pubDateRaw))) AS ?pubDate)
                  }

                  # Get publisher information
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?publisherRole .
                    ?publisherRole pro:withRole pro:publisher ;
                                  pro:isHeldBy ?publisherAgent .
                    ?publisherAgent foaf:name ?publisher .
                  }
                }
                ORDER BY ?authorPosition ?editorPosition
              }
            }
            GROUP BY ?title ?pubDate ?publisher ?edition
          }

          BIND(
            CONCAT(
              IF(BOUND(?editorList) && STRLEN(?editorList) > 0, CONCAT(?editorList, IF($language = "it", " (cur.)", " (Ed.)")), COALESCE(?authorList, "")),
              IF((BOUND(?editorList) && STRLEN(?editorList) > 0 || BOUND(?authorList)) && BOUND(?pubDate), " ", ""),
              IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
              IF(BOUND(?title) && STRLEN(?title) > 0, CONCAT(
                IF(BOUND(?editorList) && STRLEN(?editorList) > 0 || BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
                ?title,
                IF($language = "it", " [Dizionario]", " [Dictionary]")
              ), ""),
              IF(BOUND(?publisher) && STRLEN(?publisher) > 0, CONCAT(
                IF(BOUND(?editorList) && STRLEN(?editorList) > 0 || BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". ", ""),
                ?publisher
              ), ""),
              "."
            ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ThesisShape
  a sh:NodeShape ;
  sh:name "Thesis"@en, "Tesi"@it ;
  sh:targetClass fabio:Thesis ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Thesis ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication date"@en, "Data di pubblicazione"@it ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author"@en, "Autore"@it ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor"@en, "Curatore"@it ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher"@en, "Editore"@it ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier"@en, "Identificativo"@it ;
    sh:order 2 ;
    sh:node schema:BookIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
                  (GROUP_CONCAT(?publisherName; SEPARATOR = ", ") AS ?publisherList)
            WHERE {
              {
                SELECT * WHERE {
                  $this a fabio:Thesis .
                  OPTIONAL { $this dcterms:title ?title . }

                  # Get author information
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?authorRole .
                    ?authorRole pro:withRole pro:author ;
                                pro:isHeldBy ?author .
                    {
                      SELECT ?authorRole (COUNT(?previousAuthorRole) AS ?authorPosition)
                      WHERE {
                        $this pro:isDocumentContextFor ?authorRole, ?previousAuthorRole .
                        ?authorRole pro:withRole pro:author .
                        ?previousAuthorRole <https://w3id.org/oc/ontology/hasNext>* ?authorRole .
                      }
                      GROUP BY ?authorRole
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:name ?authorName .
                    }
                    OPTIONAL {
                      $this pro:isDocumentContextFor ?authorRole .
                      ?authorRole pro:withRole pro:author ;
                                  pro:isHeldBy ?author .
                      ?author foaf:familyName ?familyName .
                      OPTIONAL {
                        $this pro:isDocumentContextFor ?authorRole .
                        ?authorRole pro:withRole pro:author ;
                                    pro:isHeldBy ?author .
                        ?author foaf:givenName ?givenName .
                      }
                      BIND(CONCAT(
                        ?familyName,
                        COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                      ) AS ?authorName)
                    }
                  }

                  # Get publication date
                  OPTIONAL {
                    $this prism:publicationDate ?pubDateRaw . 
                    BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                            STR(?pubDateRaw),
                            IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                              SUBSTR(STR(?pubDateRaw), 1, 4),
                              STR(?pubDateRaw))) AS ?pubDate)
                  }

                  # Get publisher/institution information
                  OPTIONAL {
                    $this pro:isDocumentContextFor ?publisherRole .
                    ?publisherRole pro:withRole pro:publisher ;
                                  pro:isHeldBy ?publisher .
                    {
                      SELECT ?publisherRole (COUNT(?previousPublisherRole) AS ?publisherPosition)
                      WHERE {
                        $this pro:isDocumentContextFor ?publisherRole, ?previousPublisherRole .
                        ?publisherRole pro:withRole pro:publisher .
                        ?previousPublisherRole <https://w3id.org/oc/ontology/hasNext>* ?publisherRole .
                      }
                      GROUP BY ?publisherRole
                    }
                    ?publisher foaf:name ?publisherName .
                  }
                }
                ORDER BY ?authorPosition ?publisherPosition
              }
            }
            GROUP BY ?title ?pubDate
          }

          BIND(CONCAT(
            COALESCE(?authorList, ""),
            IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
            IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
            IF(BOUND(?title), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
              ?title,
              IF($language = "it", " [Tesi]", " [Thesis]")
            ), ""),
            IF(BOUND(?publisherList), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". ", ""),
              ?publisherList
            ), ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .


# Resource embodiment

schema:ResourceEmbodimentShape
  a sh:NodeShape ;
  sh:name "Page"@en, "Pagina"@it ;
  sh:targetClass fabio:Manifestation ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Manifestation ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:startingPage ;
    sh:name "Starting page"@en, "Pagina iniziale"@it ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:endingPage ;
    sh:name "Ending page"@en, "Pagina finale"@it ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this a fabio:Manifestation .
          OPTIONAL { $this prism:startingPage ?start . }
          OPTIONAL { $this prism:endingPage ?end . }

          BIND(
            IF(BOUND(?start) && BOUND(?end), 
              CONCAT(?start, "-", ?end),
              IF(BOUND(?start), 
                  ?start,
                  IF(BOUND(?end), 
                    ?end,
                    IF($language = "it", "Pagina sconosciuta", "Unknown page"))))
            AS ?display)
        }
      """ ;
    ] ;
  ]
  .

# Responsible agent

schema:ResponsibleAgentShape
  a sh:NodeShape ;
  sh:name "Responsible agent"@en, "Agente responsabile"@it ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue foaf:Agent ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:targetClass foaf:Agent ;
  dash:hidden true ;
  owl:hasKey
    ( foaf:name ) ,
    ( foaf:familyName foaf:givenName ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier"@en, "Identificativo"@it ;
    sh:order 2 ;
    sh:node schema:AgentIdentifierShape ;
  ] ;
  sh:property [
    sh:path foaf:name ;
    sh:name "Name"@en, "Nome completo"@it ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path foaf:givenName ;
    sh:name "Given name"@en, "Nome"@it ;
    sh:order 4 ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path foaf:familyName ;
    sh:name "Family name"@en, "Cognome"@it ;
    sh:order 5 ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?agentName (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              $this a foaf:Agent .

              OPTIONAL { $this foaf:name ?name. }
              OPTIONAL { $this foaf:familyName ?familyName. }
              OPTIONAL { $this foaf:givenName ?givenName. }

              BIND(
                  IF(BOUND(?name), ?name,
                      IF(BOUND(?familyName) && BOUND(?givenName), 
                          CONCAT(?familyName, ", ", ?givenName),
                          IF(BOUND(?familyName), ?familyName, 
                              IF(BOUND(?givenName), ?givenName, "")
                          )
                      )
                  ) AS ?agentName
              )

              OPTIONAL {
                $this datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                            literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
            }
            GROUP BY ?agentName
          }

          BIND(STR($this) AS ?uriString)
          BIND(STRAFTER(?uriString, "https://w3id.org/oc/meta/") AS ?omid)
          BIND(IF(STRSTARTS(?uriString, "https://w3id.org/oc/meta/") && STRLEN(?omid) > 0, CONCAT("omid:", ?omid), "") AS ?omidString)
          BIND(COALESCE(?identifiers, "") AS ?identifierList)
          BIND(IF(STRLEN(?omidString) > 0 && STRLEN(?identifierList) > 0,
                  CONCAT(?omidString, " ", ?identifierList),
                  CONCAT(?omidString, ?identifierList)
              ) AS ?idList)
          BIND(IF(STRLEN(?idList) > 0,
                  IF(STRLEN(?agentName) > 0, CONCAT(?agentName, " [", ?idList, "]"), CONCAT("[", ?idList, "]")),
                  IF(STRLEN(?agentName) > 0, ?agentName, ?uriString)
              ) AS ?display)
        }
      """ ;
    ] ;
  ]
  .

# Agent Roles

schema:AuthorShape
  a sh:NodeShape ;
  sh:name "Agent role"@en, "Ruolo dell'agente"@it ;
  sh:targetClass pro:RoleInTime ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue pro:RoleInTime ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:withRole ;
    sh:name "Role"@en, "Ruolo"@it ;
    sh:order 4 ;
    sh:hasValue pro:author ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isHeldBy ;
    sh:name "Held by"@en, "Ricoperto da"@it ;
    sh:order 2 ;
    sh:node schema:ResponsibleAgentShape ;
    sh:class foaf:Agent ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path oco:hasNext ;
    dash:hidden true ;
    sh:name "Has next"@en, "Successivo"@it ;
    sh:order 3 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT DISTINCT ?formattedName
        WHERE {
          $this pro:isHeldBy ?ra;
              pro:withRole pro:author.
          OPTIONAL {
            $this pro:isHeldBy ?ra .
            ?ra foaf:name ?name .
          }
          OPTIONAL {
            $this pro:isHeldBy ?ra .
            ?ra foaf:familyName ?familyName .
          }
          OPTIONAL {
            $this pro:isHeldBy ?ra .
            ?ra foaf:givenName ?givenName .
          }

          {
            SELECT ?ra (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              $this pro:isHeldBy ?ra .
              OPTIONAL {
                $this pro:isHeldBy ?ra .
                ?ra datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                          literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
            }
            GROUP BY ?ra
          }

          BIND(
            IF(BOUND(?name), ?name,
                IF(BOUND(?familyName) && BOUND(?givenName), CONCAT(?familyName, ", ", ?givenName),
                    IF(BOUND(?familyName), CONCAT(?familyName, ","), 
                        IF(BOUND(?givenName), CONCAT(",", ?givenName), "")
                    )
                )
            ) AS ?nameDisplay
          )

          BIND(STR(?ra) AS ?uriString)
          BIND(STRAFTER(?uriString, "https://w3id.org/oc/meta/") AS ?omid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                IF(STRSTARTS(?uriString, "https://w3id.org/oc/meta/") && STRLEN(?omid) > 0, CONCAT(?nameDisplay, " [omid:", ?omid, " ", ?identifiers, "]"), CONCAT(?nameDisplay, " [", ?identifiers, "]")),
                IF(STRSTARTS(?uriString, "https://w3id.org/oc/meta/") && STRLEN(?omid) > 0, CONCAT(?nameDisplay, " [omid:", ?omid, "]"), ?nameDisplay)
            ) AS ?formattedName)
        }
      """ ;
    ] ;
  ] .

schema:EditorShape
  a sh:NodeShape ;
  sh:name "Agent role"@en, "Ruolo dell'agente"@it ;
  sh:targetClass pro:RoleInTime ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue pro:RoleInTime ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:withRole ;
    sh:name "Role"@en, "Ruolo"@it ;
    sh:order 4 ;
    sh:hasValue pro:editor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isHeldBy ;
    sh:name "Held by"@en, "Ricoperto da"@it ;
    sh:order 2 ;
    sh:node schema:ResponsibleAgentShape ;
    sh:class foaf:Agent ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path oco:hasNext ;
    dash:hidden true ;
    sh:name "Has next"@en, "Successivo"@it ;
    sh:order 3 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT DISTINCT ?formattedName
        WHERE {
          $this pro:isHeldBy ?ra;
              pro:withRole pro:editor.
          OPTIONAL {
            $this pro:isHeldBy ?ra .
            ?ra foaf:name ?name .
          }
          OPTIONAL {
            $this pro:isHeldBy ?ra .
            ?ra foaf:familyName ?familyName .
          }
          OPTIONAL {
            $this pro:isHeldBy ?ra .
            ?ra foaf:givenName ?givenName .
          }

          {
            SELECT ?ra (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              $this pro:isHeldBy ?ra .
              OPTIONAL {
                $this pro:isHeldBy ?ra .
                ?ra datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                          literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
            }
            GROUP BY ?ra
          }

          BIND(
            IF(BOUND(?name), ?name,
                IF(BOUND(?familyName) && BOUND(?givenName), CONCAT(?familyName, ", ", ?givenName),
                    IF(BOUND(?familyName), CONCAT(?familyName, ","), 
                        IF(BOUND(?givenName), CONCAT(",", ?givenName), "")
                    )
                )
            ) AS ?nameDisplay
          )

          BIND(STR(?ra) AS ?uriString)
          BIND(STRAFTER(?uriString, "https://w3id.org/oc/meta/") AS ?omid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                IF(STRSTARTS(?uriString, "https://w3id.org/oc/meta/") && STRLEN(?omid) > 0, CONCAT(?nameDisplay, " [omid:", ?omid, " ", ?identifiers, "]"), CONCAT(?nameDisplay, " [", ?identifiers, "]")),
                IF(STRSTARTS(?uriString, "https://w3id.org/oc/meta/") && STRLEN(?omid) > 0, CONCAT(?nameDisplay, " [omid:", ?omid, "]"), ?nameDisplay)
            ) AS ?formattedName)
        }
      """ ;
    ] ;
  ] .

