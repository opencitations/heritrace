@prefix dash: <http://datashapes.org/dash#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ht: <https://w3id.org/heritrace#> .
@prefix meta: <https://w3id.org/heritrace/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

meta:ShapesGraph
  a owl:Ontology ;
  sh:declare
    [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
    [ sh:prefix "sh" ; sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI ] ,
    [ sh:prefix "shui" ; sh:namespace "http://www.w3.org/ns/shacl-ui/"^^xsd:anyURI ] .

meta:ShapesGraphShape
  a sh:NodeShape ;
  sh:name "Resource types"@en, "Tipi di risorsa"@it ;
  sh:targetClass sh:ShapesGraph ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue sh:ShapesGraph ;
    dash:hidden true ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:hasPart ;
    sh:name "Resource types"@en, "Tipi di risorsa"@it ;
    sh:order 1 ;
    sh:node meta:NodeShapeShape ;
  ] .

meta:NodeShapeShape
  a sh:NodeShape ;
  sh:name "Resource type"@en, "Tipo di risorsa"@it ;
  sh:targetClass sh:NodeShape ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue sh:NodeShape ;
    dash:hidden true ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:prefixes meta:ShapesGraph ;
      sh:select """
        SELECT ?label WHERE {
          {
            SELECT ?name (COUNT(DISTINCT ?shape) > 1 AS ?shared)
              (MAX(IF(?shape = $this, ?shortShape, "")) AS ?shortThis)
            WHERE {
              ?shape a sh:NodeShape .
              OPTIONAL { ?shape sh:name ?shapeName }
              OPTIONAL { ?shape sh:targetClass ?class }
              OPTIONAL {
                ?declaration sh:prefix ?prefix ; sh:namespace ?namespace .
                FILTER(STRSTARTS(STR(?shape), STR(?namespace)))
              }
              BIND(LCASE(REPLACE(REPLACE(REPLACE(STR(?class), "^.*[/#]", ""), "([A-Z])", " $1"), "^ ", "")) AS ?className)
              BIND(IF(BOUND(?prefix),
                CONCAT(?prefix, ":", STRAFTER(STR(?shape), STR(?namespace))),
                STR(?shape)) AS ?shortShape)
              BIND(COALESCE(?shapeName, ?className, ?shortShape) AS ?name)
            }
            GROUP BY ?name
            HAVING(SUM(IF(?shape = $this, 1, 0)) > 0)
          }
          {
            SELECT (GROUP_CONCAT(DISTINCT ?fieldName; separator=", ") AS ?fields)
            WHERE {
              ?owner sh:property ?field .
              ?field (sh:qualifiedValueShape|sh:or/rdf:rest*/rdf:first)?/sh:node $this ;
                sh:name ?fieldName .
              FILTER(?owner != $this)
              FILTER NOT EXISTS { $this sh:name ?fieldName }
            }
          }
          {
            SELECT (GROUP_CONCAT(DISTINCT ?ownerName; separator=", ") AS ?owners)
            WHERE {
              ?owner sh:property/(sh:qualifiedValueShape|sh:or/rdf:rest*/rdf:first)?/sh:node $this .
              FILTER(?owner != $this)
              OPTIONAL { ?owner sh:name ?ownerLabel }
              OPTIONAL { ?owner sh:targetClass ?ownerClass }
              OPTIONAL {
                ?declaration sh:prefix ?prefix ; sh:namespace ?namespace .
                FILTER(STRSTARTS(STR(?owner), STR(?namespace)))
              }
              BIND(LCASE(REPLACE(REPLACE(REPLACE(STR(?ownerClass), "^.*[/#]", ""), "([A-Z])", " $1"), "^ ", "")) AS ?ownerClassName)
              BIND(IF(BOUND(?prefix),
                CONCAT(?prefix, ":", STRAFTER(STR(?owner), STR(?namespace))),
                STR(?owner)) AS ?shortOwner)
              BIND(COALESCE(?ownerLabel, ?ownerClassName, ?shortOwner) AS ?ownerName)
            }
          }
          BIND(IF(?fields != "", ?fields, IF(?owners != "", ?owners, ?shortThis)) AS ?context)
          BIND(IF(?shared, CONCAT(?name, " · ", ?context), ?name) AS ?label)
        }
        LIMIT 1
      """ ;
    ] ;
  ] ;
  sh:property [
    sh:path sh:name ;
    sh:name "Name"@en, "Nome"@it ;
    sh:order 1 ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:targetClass ;
    sh:name "Class"@en, "Classe"@it ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dash:hidden ;
    sh:name "Hidden"@en, "Nascosto"@it ;
    sh:description "Resources of this type do not appear in the catalogue, in the recycle bin or among the types users can create. Other resources can still link to them."@en,
      "Le risorse di questo tipo non compaiono nel catalogo, nel cestino né tra i tipi che si possono creare. Altre risorse possono comunque collegarsi a loro."@it ;
    sh:order 3 ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:property ;
    sh:name "Fields"@en, "Campi"@it ;
    sh:order 4 ;
    sh:node meta:PropertyShapeShape ;
  ] .

meta:PropertyShapeShape
  a sh:NodeShape ;
  sh:name "Field"@en, "Campo"@it ;
  sh:targetClass sh:PropertyShape ;
  sh:or (
    [ sh:path dash:composite ; sh:in ( false ) ]
    [ sh:path sh:node ; sh:minCount 1 ]
    [ sh:path sh:class ; sh:minCount 1 ]
  ) ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue sh:PropertyShape ;
    dash:hidden true ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:prefixes meta:ShapesGraph ;
      sh:select """
        SELECT ?label WHERE {
          OPTIONAL { $this sh:name ?name }
          OPTIONAL {
            $this shui:propertyRole shui:LabelRole .
            BIND("Display label" AS ?role)
          }
          OPTIONAL {
            $this sh:path ?path .
            OPTIONAL {
              ?declaration sh:prefix ?prefix ; sh:namespace ?namespace .
              FILTER(STRSTARTS(STR(?path), STR(?namespace)))
            }
          }
          BIND(IF(BOUND(?prefix),
            CONCAT(?prefix, ":", STRAFTER(STR(?path), STR(?namespace))),
            STR(?path)) AS ?shortPath)
          BIND(COALESCE(?name, ?role, ?shortPath) AS ?label)
        }
        LIMIT 1
      """ ;
    ] ;
  ] ;
  sh:property [
    sh:path sh:name ;
    sh:name "Name"@en, "Nome"@it ;
    sh:order 1 ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:path ;
    sh:name "Property"@en, "Proprietà"@it ;
    sh:order 2 ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:description ;
    sh:name "Description"@en, "Descrizione"@it ;
    sh:description "Text shown under the field to help fill it in."@en,
      "Testo mostrato sotto il campo per aiutare a compilarlo."@it ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    shui:editor shui:TextAreaEditor ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:order ;
    dash:hidden true ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:minCount ;
    sh:name "Minimum number of values"@en, "Numero minimo di valori"@it ;
    sh:description "Enter a whole number greater than or equal to 0."@en,
      "Inserisci un numero intero maggiore o uguale a 0."@it ;
    sh:order 4 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:maxCount ;
    sh:name "Maximum number of values"@en, "Numero massimo di valori"@it ;
    sh:description "Enter a whole number greater than or equal to 0. Without it, there is no limit."@en,
      "Inserisci un numero intero maggiore o uguale a 0. Senza questo valore non c'è limite."@it ;
    sh:order 5 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:datatype ;
    sh:name "Datatype"@en, "Tipo di dato"@it ;
    sh:order 6 ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:minInclusive ;
    sh:name "Minimum value (included)"@en, "Valore minimo (incluso)"@it ;
    sh:description "The smallest value accepted."@en,
      "Il valore più piccolo accettato."@it ;
    sh:order 7 ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] ) ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:maxInclusive ;
    sh:name "Maximum value (included)"@en, "Valore massimo (incluso)"@it ;
    sh:description "The largest value accepted."@en,
      "Il valore più grande accettato."@it ;
    sh:order 8 ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] ) ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:minExclusive ;
    sh:name "Minimum value (excluded)"@en, "Valore minimo (escluso)"@it ;
    sh:description "Accepted values are greater than this number."@en,
      "I valori accettati sono maggiori di questo numero."@it ;
    sh:order 9 ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] ) ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:maxExclusive ;
    sh:name "Maximum value (excluded)"@en, "Valore massimo (escluso)"@it ;
    sh:description "Accepted values are less than this number."@en,
      "I valori accettati sono minori di questo numero."@it ;
    sh:order 10 ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] ) ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:node ;
    sh:name "Nested resource type"@en, "Tipo di risorsa annidata"@it ;
    sh:order 11 ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:class ;
    sh:name "Class of the linked resource"@en, "Classe della risorsa collegata"@it ;
    sh:order 12 ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path shui:editor ;
    sh:name "Editor"@en, "Editor"@it ;
    sh:order 13 ;
    sh:in ( shui:TextFieldEditor shui:TextAreaEditor shui:AutoCompleteEditor shui:DetailsEditor ) ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path shui:viewer ;
    sh:name "Viewer"@en, "Visualizzatore"@it ;
    sh:order 14 ;
    sh:in ( shui:DetailsViewer ) ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dash:composite ;
    sh:name "Points to a dependent resource"@en, "Punta a una risorsa dipendente"@it ;
    sh:description "A resource reached through this property has no meaning without this link. The Dependent resources setting decides what happens when the link is removed."@en,
      "Una risorsa raggiunta tramite questa proprietà non ha senso senza questo collegamento. Cosa succede quando il collegamento viene rimosso lo decide l'impostazione Risorse dipendenti."@it ;
    sh:order 15 ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dash:hidden ;
    sh:name "Hidden"@en, "Nascosto"@it ;
    sh:description "The field does not appear in forms or on resource pages. Its values are still validated."@en,
      "Il campo non compare nei form e nelle pagine delle risorse, ma i suoi valori vengono comunque validati."@it ;
    sh:order 16 ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path ht:orderedBy ;
    sh:name "Link to the next value"@en, "Collegamento al valore successivo"@it ;
    sh:description "The property that links each value to the next one. Values appear in this order and can be dragged into a new one."@en,
      "La proprietà che collega ogni valore al successivo. I valori compaiono in quest'ordine e si possono trascinare in un ordine nuovo."@it ;
    sh:order 17 ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:property ;
    sh:name "Fields shown in place"@en, "Campi mostrati sul posto"@it ;
    sh:description "The fields of the nested resource that appear inside this resource. When the list is empty, all of them appear."@en,
      "I campi della risorsa annidata che compaiono dentro questa risorsa. Se l'elenco è vuoto, compaiono tutti."@it ;
    sh:order 18 ;
    sh:node meta:DetailFieldShape ;
  ] .

meta:DetailFieldShape
  a sh:NodeShape ;
  sh:name "Field shown in place"@en, "Campo mostrato sul posto"@it ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue sh:PropertyShape ;
    dash:hidden true ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path sh:path ;
    sh:name "Property"@en, "Proprietà"@it ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] .
