@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix literal: <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix prism: <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Prefixes for the SPARQL queries in this shapes graph

[] a sh:ShapesGraph ;
  sh:declare
    [ sh:prefix "datacite" ; sh:namespace "http://purl.org/spar/datacite/"^^xsd:anyURI ] ,
    [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ,
    [ sh:prefix "fabio" ; sh:namespace "http://purl.org/spar/fabio/"^^xsd:anyURI ] ,
    [ sh:prefix "foaf" ; sh:namespace "http://xmlns.com/foaf/0.1/"^^xsd:anyURI ] ,
    [ sh:prefix "frbr" ; sh:namespace "http://purl.org/vocab/frbr/core#"^^xsd:anyURI ] ,
    [ sh:prefix "literal" ; sh:namespace "http://www.essepuntato.it/2010/06/literalreification/"^^xsd:anyURI ] ,
    [ sh:prefix "oco" ; sh:namespace "https://w3id.org/oc/ontology/"^^xsd:anyURI ] ,
    [ sh:prefix "prism" ; sh:namespace "http://prismstandard.org/namespaces/basic/2.0/"^^xsd:anyURI ] ,
    [ sh:prefix "pro" ; sh:namespace "http://purl.org/spar/pro/"^^xsd:anyURI ] .

schema:JournalArticleShape
  a sh:NodeShape ;
  sh:name "Journal Article" ;
  sh:targetClass fabio:JournalArticle ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:JournalArticle ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:JournalArticleIdentifierShape ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 5 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author" ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Container" ;
    sh:order 6 ;
    shui:editor shui:AutoCompleteEditor ;
    sh:or (
      [ sh:node schema:IssueShape ; sh:class fabio:JournalIssue ]
      [ sh:node schema:VolumeShape ; sh:class fabio:JournalVolume ]
      [ sh:node schema:JournalShape ; sh:class fabio:Journal ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:embodiment ;
    dash:composite true ;
    sh:name "Pages" ;
    sh:order 7 ;
    sh:node schema:ResourceEmbodimentShape ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?firstAuthorRole
            WHERE {
              $this pro:isDocumentContextFor ?firstAuthorRole .
              ?firstAuthorRole pro:withRole pro:author .
              FILTER NOT EXISTS {
                $this pro:isDocumentContextFor ?precedingRole .
                ?precedingRole oco:hasNext ?firstAuthorRole .
              }
            }
            ORDER BY DESC(?firstAuthorRole)
            LIMIT 1
          }
          ?firstAuthorRole pro:isHeldBy ?agent .
          ?agent foaf:familyName ?familyName .
          {
            SELECT ?date
            WHERE {
              $this prism:publicationDate ?date .
            }
            ORDER BY DESC(?date)
            LIMIT 1
          }
          {
            SELECT (GROUP_CONCAT(?identifier; separator=" ") AS ?identifiers)
            WHERE {
              {
                SELECT (CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?identifier)
                WHERE {
                  $this datacite:hasIdentifier ?identifierNode .
                  ?identifierNode datacite:usesIdentifierScheme ?scheme ;
                                  literal:hasLiteralValue ?value .
                }
                ORDER BY ?identifier
              }
            }
          }
          BIND(CONCAT("(", ?familyName, " et al., ", STR(?date), ") [", ?identifiers, "]") AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:JournalArticleIdentifierShape
  a sh:NodeShape ;
  sh:name "Identifier" ;
  sh:targetClass datacite:Identifier ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue datacite:Identifier ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:usesIdentifierScheme ;
    sh:name "Identifier Scheme" ;
    sh:order 2 ;
    sh:in (datacite:doi datacite:pmid) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path literal:hasLiteralValue ;
    sh:name "Literal Value" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT (CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?display)
        WHERE {
          $this datacite:usesIdentifierScheme ?scheme ;
                  literal:hasLiteralValue ?value .
        }
      """ ;
    ] ;
  ] .

schema:JournalShape
  a sh:NodeShape ;
  sh:name "Journal" ;
  sh:targetClass fabio:Journal ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Journal ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 2 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this dcterms:title ?display .
        }
      """ ;
    ] ;
  ] .

schema:VolumeShape
  a sh:NodeShape ;
  sh:name "Volume" ;
  sh:targetClass fabio:JournalVolume ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:JournalVolume ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path fabio:hasSequenceIdentifier ;
    sh:name "Number" ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Journal" ;
    sh:order 3 ;
    sh:node schema:JournalShape ;
    sh:class fabio:Journal ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT (CONCAT("Volume ", ?number, " of ", ?journalTitle) AS ?display)
        WHERE {
          $this fabio:hasSequenceIdentifier ?number ;
                  frbr:partOf ?journal .
          ?journal dcterms:title ?journalTitle .
        }
      """ ;
    ] ;
  ] .

schema:IssueShape
  a sh:NodeShape ;
  sh:name "Issue" ;
  sh:targetClass fabio:JournalIssue ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Expression ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:JournalIssue ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path fabio:hasSequenceIdentifier ;
    sh:name "Number" ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Volume" ;
    sh:order 3 ;
    shui:editor shui:AutoCompleteEditor ;
    sh:or (
      [ sh:node schema:VolumeShape ; sh:class fabio:JournalVolume ]
      [ sh:node schema:JournalShape ; sh:class fabio:Journal ]
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT (CONCAT("Issue ", ?issueNumber, " of Volume ", ?volumeNumber, ", ", ?journalTitle) AS ?display)
        WHERE {
          $this fabio:hasSequenceIdentifier ?issueNumber ;
                  frbr:partOf ?volume .
          ?volume fabio:hasSequenceIdentifier ?volumeNumber ;
                  frbr:partOf ?journal .
          ?journal dcterms:title ?journalTitle .
        }
      """ ;
    ] ;
  ] .

schema:ResourceEmbodimentShape
  a sh:NodeShape ;
  sh:name "Pages" ;
  sh:targetClass fabio:Manifestation ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue fabio:Manifestation ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:startingPage ;
    sh:name "Starting Page" ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:endingPage ;
    sh:name "Ending Page" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT (CONCAT(?start, "-", ?end) AS ?display)
        WHERE {
          $this prism:startingPage ?start ;
                  prism:endingPage ?end .
        }
      """ ;
    ] ;
  ] .

schema:ResponsibleAgentShape
  a sh:NodeShape ;
  sh:name "Author" ;
  sh:targetClass foaf:Agent ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue foaf:Agent ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path foaf:givenName ;
    sh:name "Given Name" ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path foaf:familyName ;
    sh:name "Family Name" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT (CONCAT(?familyName, ", ", ?givenName) AS ?display)
        WHERE {
          $this foaf:familyName ?familyName ;
                  foaf:givenName ?givenName .
        }
      """ ;
    ] ;
  ] .

schema:AuthorShape
  a sh:NodeShape ;
  sh:name "Author Role" ;
  sh:targetClass pro:RoleInTime ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:qualifiedValueShape [ sh:hasValue pro:RoleInTime ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedMaxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:withRole ;
    sh:name "Role" ;
    sh:order 3 ;
    sh:hasValue pro:author ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isHeldBy ;
    sh:name "Held By" ;
    sh:order 2 ;
    sh:node schema:ResponsibleAgentShape ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT (CONCAT(?familyName, ", ", ?givenName) AS ?display)
        WHERE {
          $this pro:withRole pro:author ;
                    pro:isHeldBy ?agent .
          ?agent foaf:familyName ?familyName ;
                 foaf:givenName ?givenName .
        }
      """ ;
    ] ;
  ]
  .
