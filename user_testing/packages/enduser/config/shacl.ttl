      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^PMC[1-9]\\d+(\\.(\\d{1,2})?)?$" ;
        sh:message "PMCID must start with 'PMC' followed by a number that doesn't start with 0, and may optionally end with a dot and 1-2 digits. For example: PMC10829861" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:isbn ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]$" ;
        sh:message "ISBN must be a valid 10 or 13-digit ISBN number, with optional hyphens. For example: 0-7475-3269-9 or 978-0-7475-3269-9" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:openalex ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^W[1-9]\\d*$" ;
        sh:message "OpenAlex work ID must start with 'W' followed by numbers. For example: W2741809807" ;
      ] ;
    ]
  ) ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this datacite:usesIdentifierScheme ?scheme ;
                  literal:hasLiteralValue ?value .
          BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?display)
        }
      """ ;
    ] ;
  ]
  .
  
schema:AgentIdentifierShape
  a sh:NodeShape ;
  sh:name "Identifier" ;
  sh:targetClass datacite:Identifier ;
  dash:hidden true ;
  owl:hasKey
    ( literal:hasLiteralValue datacite:usesIdentifierScheme ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue datacite:Identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path literal:hasLiteralValue ;
    sh:name "Literal Value" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:usesIdentifierScheme ;
    sh:name "Identifier Scheme" ;
    sh:order 2 ;
    sh:in (
      datacite:crossref
      datacite:orcid
      datacite:ror
      datacite:viaf
      datacite:wikidata
      datacite:wikipedia
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:or (
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:orcid ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^([0-9]{4}-){3}[0-9]{3}[0-9X]$" ;
        sh:message "ORCID must be in the format 'XXXX-XXXX-XXXX-XXXX' where X is a digit or 'X'. For example: 0000-0002-1825-0097" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:viaf ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^[1-9]\\d{1,21}$" ;
        sh:message "VIAF ID must be a string of 2 to 22 digits, not starting with 0. For example: 12345678" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:crossref ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^\\d+$" ;
        sh:message "Crossref ID must be a string of one or more digits. For example: 98765432" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:wikidata ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^Q[1-9]\\d*$" ;
        sh:message "Wikidata ID must start with 'Q' followed by a non-zero digit and optionally more digits. For example: Q42" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:wikipedia ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^[1-9][0-9]*$" ;
        sh:message "Wikipedia ID must be a string of digits not starting with 0. For example: 123456" ;
      ] ;
    ]
    [
      sh:property [
        sh:path datacite:usesIdentifierScheme ;
        sh:hasValue datacite:ror ;
      ] ;
      sh:property [
        sh:path literal:hasLiteralValue ;
        sh:pattern "^((https:\\/\\/)?ror\\.org\\/)?0[a-hj-km-np-tv-z|0-9]{6}[0-9]{2}$" ;
        sh:message "ROR ID must be in the format '0XXXXXXXX' where X is a digit or lowercase letter (excluding i, l, o), optionally prefixed with 'https://ror.org/'. For example: 04wxnsj81 or https://ror.org/04wxnsj81" ;
      ] ;
    ]
  ) ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this datacite:usesIdentifierScheme ?scheme ;
                  literal:hasLiteralValue ?value .
          BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?display)
        }
      """ ;
    ] ;
  ] .

# Agent roles

schema:AgentRoleShape
  a sh:NodeShape ;
  sh:name "Agent Role" ;
  sh:targetClass pro:RoleInTime ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue pro:RoleInTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path oco:hasNext ;
    dash:hidden true ;
    sh:name "Has Next" ;
    sh:order 3 ;
    sh:node schema:AgentRoleShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isHeldBy ;
    sh:name "Held By" ;
    sh:order 2 ;
    sh:node schema:ResponsibleAgentShape ;
    sh:class foaf:Agent ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:withRole ;
    sh:name "Role" ;
    sh:order 4 ;
    sh:in (pro:publisher pro:author pro:editor) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this pro:withRole ?role ;
                  pro:isHeldBy ?agent .
          OPTIONAL { ?agent foaf:name ?name. }
          OPTIONAL { ?agent foaf:familyName ?familyName. }
          OPTIONAL { ?agent foaf:givenName ?givenName. }
          BIND(
              IF(BOUND(?name), ?name,
                  IF(BOUND(?familyName) && BOUND(?givenName), 
                      CONCAT(?familyName, ", ", ?givenName),
                      IF(BOUND(?familyName), ?familyName, 
                          IF(BOUND(?givenName), ?givenName, STR(?agent))
                      )
                  )
              ) AS ?agentDisplay
          )
          BIND(
            CONCAT(STRAFTER(STR(?role), "pro/"), ": ", ?agentDisplay) AS ?display
          )
        }
      """ ;
    ] ;
  ]
  .

# Bibliographic resources

schema:ExpressionShape
  a sh:NodeShape ;
  sh:name "Bibliographic Resource" ;
  sh:targetClass fabio:Expression ;
  dash:hidden true ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:or (
      [ sh:hasValue fabio:JournalArticle ]
      [ sh:hasValue fabio:Book ]
      [ sh:hasValue fabio:ProceedingsPaper ]
      [ sh:hasValue fabio:AcademicProceedings ]
      [ sh:hasValue fabio:Journal ]
      [ sh:hasValue fabio:JournalVolume ]
      [ sh:hasValue fabio:JournalIssue ]
      [ sh:hasValue fabio:ReferenceBook ]
      [ sh:hasValue fabio:Review ]
      [ sh:hasValue fabio:ReviewArticle ]
      [ sh:hasValue fabio:Thesis ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:IdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:embodiment ;
    dash:composite true ;
    sh:name "Page" ;
    sh:order 8 ;
    sh:node schema:ResourceEmbodimentShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:withRole ] , [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:order 6 ;
    sh:node schema:AgentRoleShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Part Of" ;
    sh:order 9 ;
    sh:node schema:BibliographicResourceShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?entityType ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage ?bookTitle ?proceedingsTitle
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
            WHERE {
              $this a fabio:Expression .
              OPTIONAL { 
                $this a ?specificType .
                FILTER(?specificType != fabio:Expression)
              }
              BIND(COALESCE(?specificType, fabio:Expression) AS ?entityType)

              OPTIONAL { $this dcterms:title ?title . }

              # Authors (not applicable for Journal, Volume, Issue)
              OPTIONAL {
                FILTER(?entityType NOT IN (fabio:JournalVolume, fabio:JournalIssue))
                $this pro:isDocumentContextFor ?authorRole .
                ?authorRole pro:withRole pro:author ;
                            pro:isHeldBy ?author .
                OPTIONAL { ?author foaf:name ?authorName . }
                OPTIONAL {
                  ?author foaf:familyName ?familyName .
                  OPTIONAL { ?author foaf:givenName ?givenName . }
                  BIND(CONCAT(?familyName, COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")) AS ?authorName)
                }
              }

              # Publication Date
              OPTIONAL {
                $this prism:publicationDate ?pubDateRaw . 
                BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, STR(?pubDateRaw),
                    IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), SUBSTR(STR(?pubDateRaw), 1, 4),
                    STR(?pubDateRaw))) AS ?pubDate)
              }

              # Journal Article, Volume, and Issue specific info
              OPTIONAL {
                {
                  $this frbr:partOf ?journal .
                  ?journal a fabio:Journal ;
                          dcterms:title ?journalTitle .
                }
                UNION
                {
                  $this frbr:partOf ?volume .
                  ?volume a fabio:JournalVolume ;
                          fabio:hasSequenceIdentifier ?volumeNumber ;
                          frbr:partOf ?journal .
                  ?journal a fabio:Journal ;
                          dcterms:title ?journalTitle .
                }
                UNION
                {
                  $this frbr:partOf ?issue .
                  ?issue a fabio:JournalIssue ;
                        fabio:hasSequenceIdentifier ?issueNumber ;
                        frbr:partOf ?volume .
                  ?volume a fabio:JournalVolume ;
                          fabio:hasSequenceIdentifier ?volumeNumber ;
                          frbr:partOf ?journal .
                  ?journal a fabio:Journal ;
                          dcterms:title ?journalTitle .
                }
              }

              # Book Chapter specific info
              OPTIONAL {
                FILTER(?entityType IN (fabio:BookChapter, fabio:Expression))
                $this frbr:partOf ?book .
                ?book a fabio:Book ;
                      dcterms:title ?bookTitle .
              }

              # Proceedings Paper specific info
              OPTIONAL {
                FILTER(?entityType IN (fabio:ProceedingsPaper, fabio:Expression))
                $this frbr:partOf ?proceedings .
                ?proceedings a fabio:AcademicProceedings ;
                            dcterms:title ?proceedingsTitle .
              }

              # Page information
              OPTIONAL {
                $this frbr:embodiment ?embodiment .
                OPTIONAL { ?embodiment prism:startingPage ?startPage . }
                OPTIONAL { ?embodiment prism:endingPage ?endPage . }
              }
            }
            GROUP BY ?entityType ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage ?bookTitle ?proceedingsTitle
          }

          # Construct the display string based on entity type
          BIND(
            IF(?entityType IN (fabio:JournalArticle, fabio:Expression), 
              CONCAT(COALESCE(?authorList, ""),
                    IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                    IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                    IF(BOUND(?title), CONCAT(". ", ?title), ""),
                    IF(BOUND(?journalTitle), CONCAT(". ", ?journalTitle), ""),
                    IF(BOUND(?volumeNumber), CONCAT(", ", ?volumeNumber), ""),
                    IF(BOUND(?issueNumber), CONCAT("(", ?issueNumber, ")"), ""),
                    IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
                    COALESCE(?startPage, ""),
                    IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
                    COALESCE(?endPage, ""),
                    "."),
            IF(?entityType IN (fabio:BookChapter, fabio:Expression),
              CONCAT(COALESCE(?authorList, ""),
                    IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                    IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                    IF(BOUND(?title), CONCAT(". ", ?title), ""),
                    IF(BOUND(?bookTitle), CONCAT(". In: ", ?bookTitle), ""),
                    IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
                    COALESCE(?startPage, ""),
                    IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
                    COALESCE(?endPage, ""),
                    "."),
            IF(?entityType IN (fabio:ProceedingsPaper, fabio:Expression),
              CONCAT(COALESCE(?authorList, ""),
                    IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                    IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                    IF(BOUND(?title), CONCAT(". ", ?title), ""),
                    IF(BOUND(?proceedingsTitle), CONCAT(". In: ", ?proceedingsTitle), ""),
                    IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
                    COALESCE(?startPage, ""),
                    IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
                    COALESCE(?endPage, ""),
                    "."),
            IF(?entityType IN (fabio:Book, fabio:Expression),
              CONCAT(COALESCE(?authorList, ""),
                    IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                    IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                    IF(BOUND(?title), CONCAT(". ", ?title), ""),
                    "."),
            IF(?entityType IN (fabio:AcademicProceedings, fabio:Expression),
              CONCAT(IF(BOUND(?title), ?title, ""),
                    IF(BOUND(?pubDate), CONCAT(" (", ?pubDate, ")"), ""),
                    "."),
            IF(?entityType IN (fabio:JournalVolume, fabio:Expression),
              CONCAT("Volume ", ?volumeNumber,
                    IF(BOUND(?journalTitle), CONCAT(" of ", ?journalTitle), ""),
                    "."),
            IF(?entityType IN (fabio:JournalIssue, fabio:Expression),
              CONCAT("Issue ", ?issueNumber,
                    IF(BOUND(?volumeNumber), CONCAT(" of Volume ", ?volumeNumber), ""),
                    IF(BOUND(?journalTitle), CONCAT(", ", ?journalTitle), ""),
                    "."),
            IF(?entityType = fabio:Journal,
              CONCAT(?title,
                    IF(BOUND(?pubDate), CONCAT(" (", ?pubDate, ")"), ""),
                    "."),
            "Unknown entity type."
          )))))))) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:JournalArticleShape
  a sh:NodeShape ;
  sh:name "Journal Article" ;
  sh:targetClass fabio:JournalArticle ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:JournalArticleIdentifierShape ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:JournalArticle ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Issue" ;
    sh:order 9 ;
    sh:node schema:IssueShape ;
    sh:class fabio:JournalIssue ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:embodiment ;
    dash:composite true ;
    sh:name "Page" ;
    sh:order 8 ;
    sh:node schema:ResourceEmbodimentShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author" ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor" ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher" ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
            WHERE {
              $this a fabio:JournalArticle .
              OPTIONAL { $this dcterms:title ?title . }
              OPTIONAL {
                $this pro:isDocumentContextFor ?authorRole .
                ?authorRole pro:withRole pro:author ;
                            pro:isHeldBy ?author .
                OPTIONAL { ?author foaf:name ?authorName . }
                OPTIONAL {
                  ?author foaf:familyName ?familyName .
                  OPTIONAL { ?author foaf:givenName ?givenName . }
                  BIND(CONCAT(
                    ?familyName,
                    COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                  ) AS ?authorName)
                }
              }
              OPTIONAL {
                $this prism:publicationDate ?pubDateRaw . 
                BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                        STR(?pubDateRaw),
                        IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                          SUBSTR(STR(?pubDateRaw), 1, 4),
                          STR(?pubDateRaw))) AS ?pubDate)
              }
              OPTIONAL {
                $this frbr:partOf ?issue .
                ?issue a fabio:JournalIssue ;
                      frbr:partOf ?volume .
                ?volume a fabio:JournalVolume ;
                        fabio:hasSequenceIdentifier ?volumeNumber ;
                        frbr:partOf ?journal .
                ?journal dcterms:title ?journalTitle .
                OPTIONAL { ?issue fabio:hasSequenceIdentifier ?issueNumber . }
              }
              OPTIONAL {
                $this frbr:embodiment ?embodiment .
                OPTIONAL { ?embodiment prism:startingPage ?startPage . }
                OPTIONAL { ?embodiment prism:endingPage ?endPage . }
              }
            }
            GROUP BY ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage
          }

          BIND(CONCAT(
            COALESCE(?authorList, ""),
            IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
            IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
            IF(BOUND(?title), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
              ?title
            ), ""),
            IF(BOUND(?journalTitle), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". ", ""),
              ?journalTitle
            ), ""),
            IF(BOUND(?volumeNumber), CONCAT(", ", ?volumeNumber), ""),
            IF(BOUND(?issueNumber), CONCAT("(", ?issueNumber, ")"), ""),
            IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
            COALESCE(?startPage, ""),
            IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
            COALESCE(?endPage, ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:BookShape
  a sh:NodeShape ;
  sh:name "Monograph" ;
  sh:targetClass fabio:Book ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:BookIdentifierShape ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Book ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author" ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor" ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher" ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?publisher
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
                  (GROUP_CONCAT(?editorName; SEPARATOR = ", ") AS ?editorList)
            WHERE {
              $this a fabio:Book .
              OPTIONAL { $this dcterms:title ?title . }

              # Get author information
              OPTIONAL {
                $this pro:isDocumentContextFor ?authorRole .
                ?authorRole pro:withRole pro:author ;
                            pro:isHeldBy ?author .
                OPTIONAL { ?author foaf:name ?authorName . }
                OPTIONAL {
                  ?author foaf:familyName ?familyName .
                  OPTIONAL { ?author foaf:givenName ?givenName . }
                  BIND(CONCAT(
                    ?familyName,
                    COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                  ) AS ?authorName)
                }
              }

              # Get editor information
              OPTIONAL {
                $this pro:isDocumentContextFor ?editorRole .
                ?editorRole pro:withRole pro:editor ;
                            pro:isHeldBy ?editor .
                OPTIONAL { ?editor foaf:name ?editorName . }
                OPTIONAL {
                  ?editor foaf:familyName ?familyName .
                  OPTIONAL { ?editor foaf:givenName ?givenName . }
                  BIND(CONCAT(
                    ?familyName,
                    COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                  ) AS ?editorName)
                }
              }

              # Get publication date
              OPTIONAL {
                $this prism:publicationDate ?pubDateRaw . 
                BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                        STR(?pubDateRaw),
                        IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                          SUBSTR(STR(?pubDateRaw), 1, 4),
                          STR(?pubDateRaw))) AS ?pubDate)
              }

              # Get publisher information
              OPTIONAL {
                $this pro:isDocumentContextFor ?publisherRole .
                ?publisherRole pro:withRole pro:publisher ;
                              pro:isHeldBy ?publisherAgent .
                ?publisherAgent foaf:name ?publisher .
              }
            }
            GROUP BY ?title ?pubDate ?publisher
          }

          # Construct the display string based on available information
          BIND(
            IF(BOUND(?editorList) && (!BOUND(?authorList) || ?authorList = ""),
              # Case 1: Only editors
              CONCAT(
                ?editorList, " (Ed.)",
                IF(BOUND(?pubDate), CONCAT(" (", ?pubDate, ")"), ""),
                IF(BOUND(?title), CONCAT(". ", ?title), ""),
                IF(BOUND(?publisher), CONCAT(". ", ?publisher), ""),
                "."
              ),
              # Case 2: Authors (with or without editors)
              CONCAT(
                COALESCE(?authorList, ""),
                IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
                IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
                IF(BOUND(?title), CONCAT(". ", ?title), ""),
                IF(BOUND(?editorList), CONCAT(". ", ?editorList, " (Ed.)"), ""),
                IF(BOUND(?publisher), CONCAT(". ", ?publisher), ""),
                "."
              )
            ) AS ?displayWithDot
          )

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ProceedingsPaperShape
  a sh:NodeShape ;
  sh:name "Proceedings Paper" ;
  sh:targetClass fabio:ProceedingsPaper ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:ProceedingsPaper ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Conference Proceedings" ;
    sh:order 9 ;
    sh:node schema:ProceedingsShape ;
    sh:class fabio:AcademicProceedings ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:embodiment ;
    dash:composite true ;
    sh:name "Page" ;
    sh:order 8 ;
    sh:node schema:ResourceEmbodimentShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author" ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor" ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher" ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:JournalArticleIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?proceedingsTitle
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
            WHERE {
              $this a fabio:ProceedingsPaper .
              OPTIONAL { $this dcterms:title ?title . }
              OPTIONAL {
                $this pro:isDocumentContextFor ?authorRole .
                ?authorRole pro:withRole pro:author ;
                            pro:isHeldBy ?author .
                OPTIONAL { ?author foaf:name ?authorName . }
                OPTIONAL {
                  ?author foaf:familyName ?familyName .
                  OPTIONAL { ?author foaf:givenName ?givenName . }
                  BIND(CONCAT(
                    ?familyName,
                    COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                  ) AS ?authorName)
                }
              }
              OPTIONAL {
                $this prism:publicationDate ?pubDateRaw . 
                BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                        STR(?pubDateRaw),
                        IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                          SUBSTR(STR(?pubDateRaw), 1, 4),
                          STR(?pubDateRaw))) AS ?pubDate)
              }
              OPTIONAL {
                $this frbr:partOf ?proceedings .
                ?proceedings a fabio:AcademicProceedings ;
                            dcterms:title ?proceedingsTitle .
              }
            }
            GROUP BY ?title ?pubDate ?proceedingsTitle
          }

          BIND(CONCAT(
            COALESCE(?authorList, ""),
            IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
            IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
            IF(BOUND(?title), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
              ?title
            ), ""),
            IF(BOUND(?proceedingsTitle), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". In: ", "In: "),
              ?proceedingsTitle
            ), ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ProceedingsShape
  a sh:NodeShape ;
  sh:name "Proceedings" ;
  sh:targetClass fabio:AcademicProceedings ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:AcademicProceedings ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 6 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor" ;
    sh:order 4 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher" ;
    sh:order 5 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:SeriesAndProceedingsIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this a fabio:AcademicProceedings ;
                  dcterms:title ?title .
          OPTIONAL {
            $this prism:publicationDate ?pubDateRaw . 
            BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                    STR(?pubDateRaw),
                    IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                      SUBSTR(STR(?pubDateRaw), 1, 4),
                      STR(?pubDateRaw))) AS ?pubDate)
          }
          OPTIONAL {
            SELECT (GROUP_CONCAT(?editorName; SEPARATOR = ", ") AS ?editorList)
            WHERE {
              $this pro:isDocumentContextFor ?editorRole .
              ?editorRole pro:withRole pro:editor ;
                          pro:isHeldBy ?editor .
              OPTIONAL { ?editor foaf:name ?editorName . }
              OPTIONAL {
                ?editor foaf:familyName ?familyName .
                OPTIONAL { ?editor foaf:givenName ?givenName . }
                BIND(CONCAT(
                  ?familyName,
                  COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                ) AS ?editorName)
              }
            }
          }

          BIND(CONCAT(
            ?title,
            IF(BOUND(?editorList) && STRLEN(?editorList) > 0, CONCAT(". ", ?editorList, " (Ed.)"), ""),
            IF(BOUND(?pubDate), CONCAT(" (", ?pubDate, ")"), ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:JournalShape
  a sh:NodeShape ;
  sh:name "Journal" ;
  sh:targetClass fabio:Journal ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Journal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:JournalIdentifierShape ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              $this dcterms:title ?title .

              # Get all identifiers
              OPTIONAL {
                $this datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                          literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
            }
            GROUP BY ?title
          }

          # Format display string with OMID and identifiers
          BIND(STR($this) AS ?uriString)
          BIND(STRAFTER(?uriString, "https://w3id.org/oc/meta/") AS ?omid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                CONCAT(?title, " [omid:", ?omid, " ", ?identifiers, "]"),
                CONCAT(?title, " [omid:", ?omid, "]")
              ) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:VolumeShape
  a sh:NodeShape ;
  sh:name "Volume" ;
  sh:targetClass fabio:JournalVolume ;
  owl:hasKey
    ( fabio:hasSequenceIdentifier frbr:partOf ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:JournalVolume ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path fabio:hasSequenceIdentifier ;
    sh:name "Number" ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Journal" ;
    sh:order 3 ;
    sh:node schema:JournalShape ;
    sh:class fabio:Journal ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this fabio:hasSequenceIdentifier ?number ;
                  frbr:partOf ?journal .
          ?journal a fabio:Journal ;
                  dcterms:title ?journalTitle .

          # Get journal identifiers
          OPTIONAL {
            SELECT ?journal (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              ?journal datacite:hasIdentifier ?identifier .
              ?identifier datacite:usesIdentifierScheme ?scheme ;
                        literal:hasLiteralValue ?value .
              BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
            }
            GROUP BY ?journal
          }

          # Format display with journal OMID and identifiers
          BIND(STR(?journal) AS ?journalUriString)
          BIND(STRAFTER(?journalUriString, "https://w3id.org/oc/meta/") AS ?journalOmid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                CONCAT("Volume ", ?number, " of ", ?journalTitle, " [omid:", ?journalOmid, " ", ?identifiers, "]" ),
                CONCAT("Volume ", ?number, " of ", ?journalTitle, " [omid:", ?journalOmid, "]")
              ) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:IssueShape
  a sh:NodeShape ;
  sh:name "Issue" ;
  sh:targetClass fabio:JournalIssue ;
  owl:hasKey
    ( fabio:hasSequenceIdentifier frbr:partOf ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:JournalIssue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path fabio:hasSequenceIdentifier ;
    sh:name "Number" ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Volume" ;
    sh:order 3 ;
    sh:node schema:VolumeShape ;
    sh:class fabio:JournalVolume ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this fabio:hasSequenceIdentifier ?number .

          # Issue must be part of Volume according to SHACL
          $this frbr:partOf ?volume .
          ?volume a fabio:JournalVolume ;
                  fabio:hasSequenceIdentifier ?volumeNumber .

          # Volume must be part of Journal according to SHACL
          ?volume frbr:partOf ?journal .
          ?journal a fabio:Journal ;
                  dcterms:title ?journalTitle .

          # Get journal identifiers
          OPTIONAL {
            SELECT ?journal (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              ?journal datacite:hasIdentifier ?identifier .
              ?identifier datacite:usesIdentifierScheme ?scheme ;
                        literal:hasLiteralValue ?value .
              BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
            }
            GROUP BY ?journal
          }

          # Format display with journal OMID and identifiers
          BIND(STR(?journal) AS ?journalUriString)
          BIND(STRAFTER(?journalUriString, "https://w3id.org/oc/meta/") AS ?journalOmid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                CONCAT("Issue ", ?number, " of Volume ", ?volumeNumber, ", ", ?journalTitle, " [omid:", ?journalOmid, " ", ?identifiers, "]" ),
                CONCAT("Issue ", ?number, " of Volume ", ?volumeNumber, ", ", ?journalTitle, " [omid:", ?journalOmid, "]")
              ) AS ?display)
        }
      """ ;
    ] ;
  ] .


schema:ReferenceBookShape
  a sh:NodeShape ;
  sh:name "Dictionary" ;
  sh:targetClass fabio:ReferenceBook ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:ReferenceBook ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author" ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor" ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher" ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:BookIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?publisher ?edition
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
                  (GROUP_CONCAT(?editorName; SEPARATOR = ", ") AS ?editorList)
            WHERE {
              $this a fabio:ReferenceBook .
              OPTIONAL { $this dcterms:title ?title . }

              # Get author information
              OPTIONAL {
                $this pro:isDocumentContextFor ?authorRole .
                ?authorRole pro:withRole pro:author ;
                            pro:isHeldBy ?author .
                OPTIONAL { ?author foaf:name ?authorName . }
                OPTIONAL {
                  ?author foaf:familyName ?familyName .
                  OPTIONAL { ?author foaf:givenName ?givenName . }
                  BIND(CONCAT(
                    ?familyName,
                    COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                  ) AS ?authorName)
                }
              }

              # Get editor information
              OPTIONAL {
                $this pro:isDocumentContextFor ?editorRole .
                ?editorRole pro:withRole pro:editor ;
                            pro:isHeldBy ?editor .
                OPTIONAL { ?editor foaf:name ?editorName . }
                OPTIONAL {
                  ?editor foaf:familyName ?familyName .
                  OPTIONAL { ?editor foaf:givenName ?givenName . }
                  BIND(CONCAT(
                    ?familyName,
                    COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                  ) AS ?editorName)
                }
              }

              # Get publication date
              OPTIONAL {
                $this prism:publicationDate ?pubDateRaw . 
                BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                        STR(?pubDateRaw),
                        IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                          SUBSTR(STR(?pubDateRaw), 1, 4),
                          STR(?pubDateRaw))) AS ?pubDate)
              }

              # Get publisher information
              OPTIONAL {
                $this pro:isDocumentContextFor ?publisherRole .
                ?publisherRole pro:withRole pro:publisher ;
                              pro:isHeldBy ?publisherAgent .
                ?publisherAgent foaf:name ?publisher .
              }
            }
            GROUP BY ?title ?pubDate ?publisher ?edition
          }

          BIND(CONCAT(
            IF(BOUND(?editorList) && STRLEN(?editorList) > 0, CONCAT(?editorList, " (Ed.)"),
              COALESCE(?authorList, "")),
            IF((BOUND(?editorList) && STRLEN(?editorList) > 0 || BOUND(?authorList)) && BOUND(?pubDate), " ", ""),
            IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
            IF(BOUND(?title) && STRLEN(?title) > 0, CONCAT(
              IF(BOUND(?editorList) && STRLEN(?editorList) > 0 || BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
              ?title,
              " [Dictionary]"
            ), ""),
            IF(BOUND(?publisher) && STRLEN(?publisher) > 0, CONCAT(
              IF(BOUND(?editorList) && STRLEN(?editorList) > 0 || BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". ", ""),
              ?publisher
            ), ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ReviewShape
  a sh:NodeShape ;
  sh:name "Review" ;
  sh:targetClass fabio:Review ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Review ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author" ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor" ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher" ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:JournalIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path frbr:embodiment ;
    dash:composite true ;
    sh:name "Page" ;
    sh:order 8 ;
    sh:node schema:ResourceEmbodimentShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Book" ;
    sh:order 9 ;
    sh:node schema:JournalShape ;
    sh:class fabio:Journal ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?containerTitle ?volumeNumber ?issueNumber ?startPage ?endPage
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
            WHERE {
              $this a fabio:Review .
              OPTIONAL { $this dcterms:title ?title . }

              # Get author information
              OPTIONAL {
                $this pro:isDocumentContextFor ?authorRole .
                ?authorRole pro:withRole pro:author ;
                            pro:isHeldBy ?author .
                OPTIONAL { ?author foaf:name ?authorName . }
                OPTIONAL {
                  ?author foaf:familyName ?familyName .
                  OPTIONAL { ?author foaf:givenName ?givenName . }
                  BIND(CONCAT(
                    ?familyName,
                    COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                  ) AS ?authorName)
                }
              }

              # Get publication date
              OPTIONAL {
                $this prism:publicationDate ?pubDateRaw . 
                BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                        STR(?pubDateRaw),
                        IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                          SUBSTR(STR(?pubDateRaw), 1, 4),
                          STR(?pubDateRaw))) AS ?pubDate)
              }

              # Get container information (journal, book, or proceedings)
              OPTIONAL {
                $this frbr:partOf ?container .
                ?container dcterms:title ?containerTitle .

                # If it's part of a journal, get volume and issue
                OPTIONAL {
                  ?container a fabio:Journal .
                  OPTIONAL {
                    $this frbr:partOf ?issue .
                    ?issue a fabio:JournalIssue ;
                          frbr:partOf ?volume .
                    ?volume a fabio:JournalVolume ;
                            fabio:hasSequenceIdentifier ?volumeNumber .
                    OPTIONAL { ?issue fabio:hasSequenceIdentifier ?issueNumber . }
                  }
                }
              }

              # Get page information
              OPTIONAL {
                $this frbr:embodiment ?embodiment .
                OPTIONAL { ?embodiment prism:startingPage ?startPage . }
                OPTIONAL { ?embodiment prism:endingPage ?endPage . }
              }
            }
            GROUP BY ?title ?pubDate ?containerTitle ?volumeNumber ?issueNumber ?startPage ?endPage
          }

          BIND(CONCAT(
            COALESCE(?authorList, ""),
            IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
            IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
            IF(BOUND(?title), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
              ?title,
              " [Review]"
            ), ""),
            IF(BOUND(?containerTitle), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". ", ""),
              ?containerTitle
            ), ""),
            IF(BOUND(?volumeNumber), CONCAT(", ", ?volumeNumber), ""),
            IF(BOUND(?issueNumber), CONCAT("(", ?issueNumber, ")"), ""),
            IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
            COALESCE(?startPage, ""),
            IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
            COALESCE(?endPage, ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ReviewArticleShape
  a sh:NodeShape ;
  sh:name "Review Article" ;
  sh:targetClass fabio:ReviewArticle ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:ReviewArticle ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:partOf ;
    sh:name "Issue" ;
    sh:order 9 ;
    sh:node schema:IssueShape ;
    sh:class fabio:JournalIssue ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path frbr:embodiment ;
    dash:composite true ;
    sh:name "Page" ;
    sh:order 8 ;
    sh:node schema:ResourceEmbodimentShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author" ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor" ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher" ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:JournalArticleIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
            WHERE {
              $this a fabio:ReviewArticle .
              OPTIONAL { $this dcterms:title ?title . }

              # Get author information
              OPTIONAL {
                $this pro:isDocumentContextFor ?authorRole .
                ?authorRole pro:withRole pro:author ;
                            pro:isHeldBy ?author .
                OPTIONAL { ?author foaf:name ?authorName . }
                OPTIONAL {
                  ?author foaf:familyName ?familyName .
                  OPTIONAL { ?author foaf:givenName ?givenName . }
                  BIND(CONCAT(
                    ?familyName,
                    COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                  ) AS ?authorName)
                }
              }

              # Get publication date
              OPTIONAL {
                $this prism:publicationDate ?pubDateRaw . 
                BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                        STR(?pubDateRaw),
                        IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                          SUBSTR(STR(?pubDateRaw), 1, 4),
                          STR(?pubDateRaw))) AS ?pubDate)
              }

              # Get journal information
              OPTIONAL {
                $this frbr:partOf ?issue .
                ?issue a fabio:JournalIssue ;
                      frbr:partOf ?volume .
                ?volume a fabio:JournalVolume ;
                        fabio:hasSequenceIdentifier ?volumeNumber ;
                        frbr:partOf ?journal .
                ?journal dcterms:title ?journalTitle .
                OPTIONAL { ?issue fabio:hasSequenceIdentifier ?issueNumber . }
              }

              # Get page information
              OPTIONAL {
                $this frbr:embodiment ?embodiment .
                OPTIONAL { ?embodiment prism:startingPage ?startPage . }
                OPTIONAL { ?embodiment prism:endingPage ?endPage . }
              }
            }
            GROUP BY ?title ?pubDate ?journalTitle ?volumeNumber ?issueNumber ?startPage ?endPage
          }

          BIND(CONCAT(
            COALESCE(?authorList, ""),
            IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
            IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
            IF(BOUND(?title), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
              ?title,
              " [Review Article]"
            ), ""),
            IF(BOUND(?journalTitle), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". ", ""),
              ?journalTitle
            ), ""),
            IF(BOUND(?volumeNumber), CONCAT(", ", ?volumeNumber), ""),
            IF(BOUND(?issueNumber), CONCAT("(", ?issueNumber, ")"), ""),
            IF(BOUND(?startPage) || BOUND(?endPage), ", ", ""),
            COALESCE(?startPage, ""),
            IF(BOUND(?startPage) && BOUND(?endPage), "-", ""),
            COALESCE(?endPage, ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .

schema:ThesisShape
  a sh:NodeShape ;
  sh:name "Thesis" ;
  sh:targetClass fabio:Thesis ;
  owl:hasKey
    ( dcterms:title ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Expression ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Thesis ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:name "Title" ;
    sh:order 3 ;
    shui:editor shui:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication Date" ;
    sh:order 7 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYearMonth ]
      [ sh:datatype xsd:gYear ]
    ) ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Author" ;
    sh:order 4 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Editor" ;
    sh:order 5 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path pro:isDocumentContextFor ;
    ht:orderedBy oco:hasNext ;
    shui:editor shui:DetailsEditor ;
    sh:property [ sh:path pro:isHeldBy ] ;
    shui:viewer shui:DetailsViewer ;
    dash:composite true ;
    sh:name "Publisher" ;
    sh:order 6 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:BookIdentifierShape ;
    sh:minCount 0 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?title ?pubDate
                  (GROUP_CONCAT(?authorName; SEPARATOR = " & ") AS ?authorList)
                  (GROUP_CONCAT(?publisherName; SEPARATOR = ", ") AS ?publisherList)
            WHERE {
              $this a fabio:Thesis .
              OPTIONAL { $this dcterms:title ?title . }

              # Get author information
              OPTIONAL {
                $this pro:isDocumentContextFor ?authorRole .
                ?authorRole pro:withRole pro:author ;
                            pro:isHeldBy ?author .
                OPTIONAL { ?author foaf:name ?authorName . }
                OPTIONAL {
                  ?author foaf:familyName ?familyName .
                  OPTIONAL { ?author foaf:givenName ?givenName . }
                  BIND(CONCAT(
                    ?familyName,
                    COALESCE(CONCAT(", ", SUBSTR(?givenName, 1, 1), "."), "")
                  ) AS ?authorName)
                }
              }

              # Get publication date
              OPTIONAL {
                $this prism:publicationDate ?pubDateRaw . 
                BIND(IF(DATATYPE(?pubDateRaw) = xsd:gYear, 
                        STR(?pubDateRaw),
                        IF(DATATYPE(?pubDateRaw) IN (xsd:date, xsd:dateTime), 
                          SUBSTR(STR(?pubDateRaw), 1, 4),
                          STR(?pubDateRaw))) AS ?pubDate)
              }

              # Get publisher/institution information
              OPTIONAL {
                $this pro:isDocumentContextFor ?publisherRole .
                ?publisherRole pro:withRole pro:publisher ;
                              pro:isHeldBy ?publisher .
                ?publisher foaf:name ?publisherName .
              }
            }
            GROUP BY ?title ?pubDate
          }

          BIND(CONCAT(
            COALESCE(?authorList, ""),
            IF(BOUND(?authorList) && BOUND(?pubDate), " ", ""),
            IF(BOUND(?pubDate), CONCAT("(", ?pubDate, ")"), ""),
            IF(BOUND(?title), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate), ". ", ""),
              ?title,
              " [Thesis]"
            ), ""),
            IF(BOUND(?publisherList), CONCAT(
              IF(BOUND(?authorList) || BOUND(?pubDate) || BOUND(?title), ". ", ""),
              ?publisherList
            ), ""),
            "."
          ) AS ?displayWithDot)

          BIND(REPLACE(REPLACE(?displayWithDot, "([^.])[.][.] ", "$1. "), "^[., ]+|[., ]+$", "") AS ?displayTrimmed)
          BIND(IF(STRLEN(?displayTrimmed) > 0, CONCAT(?displayTrimmed, "."), ?displayTrimmed) AS ?display)
        }
      """ ;
    ] ;
  ] .


# Resource embodiment

schema:ResourceEmbodimentShape
  a sh:NodeShape ;
  sh:name "Page" ;
  sh:targetClass fabio:Manifestation ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue fabio:Manifestation ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:startingPage ;
    sh:name "Starting Page" ;
    sh:order 2 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prism:endingPage ;
    sh:name "Ending Page" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          $this a fabio:Manifestation .
          OPTIONAL { $this prism:startingPage ?start . }
          OPTIONAL { $this prism:endingPage ?end . }

          BIND(
            IF(BOUND(?start) && BOUND(?end), 
              CONCAT(?start, "-", ?end),
              IF(BOUND(?start), 
                  ?start,
                  IF(BOUND(?end), 
                    ?end,
                    "Unknown page")))
            AS ?display)
        }
      """ ;
    ] ;
  ]
  .

# Responsible agent

schema:ResponsibleAgentShape
  a sh:NodeShape ;
  sh:name "Responsible Agent" ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue foaf:Agent ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:targetClass foaf:Agent ;
  dash:hidden true ;
  owl:hasKey
    ( foaf:name ) ,
    ( foaf:familyName foaf:givenName ) ,
    ( datacite:hasIdentifier ) ;
  sh:property [
    sh:path datacite:hasIdentifier ;
    dash:composite true ;
    sh:name "Identifier" ;
    sh:order 2 ;
    sh:node schema:AgentIdentifierShape ;
  ] ;
  sh:property [
    sh:path foaf:name ;
    sh:name "Name" ;
    sh:order 3 ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path foaf:givenName ;
    sh:name "Given Name" ;
    sh:order 4 ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path foaf:familyName ;
    sh:name "Family Name" ;
    sh:order 5 ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT ?display
        WHERE {
          {
            SELECT ?agentName (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              $this a foaf:Agent .

              OPTIONAL { $this foaf:name ?name. }
              OPTIONAL { $this foaf:familyName ?familyName. }
              OPTIONAL { $this foaf:givenName ?givenName. }

              BIND(
                  IF(BOUND(?name), ?name,
                      IF(BOUND(?familyName) && BOUND(?givenName), 
                          CONCAT(?familyName, ", ", ?givenName),
                          IF(BOUND(?familyName), ?familyName, 
                              IF(BOUND(?givenName), ?givenName, "Unnamed Agent")
                          )
                      )
                  ) AS ?agentName
              )

              OPTIONAL {
                $this datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                            literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
            }
            GROUP BY ?agentName
          }

          BIND(STR($this) AS ?uriString)
          BIND(STRAFTER(?uriString, "https://w3id.org/oc/meta/") AS ?omid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                  CONCAT(?agentName, " [omid:", ?omid, " ", ?identifiers, "]"),
                  CONCAT(?agentName, " [omid:", ?omid, "]")
              ) AS ?display)
        }
      """ ;
    ] ;
  ]
  .

# Agent Roles

schema:AuthorShape
  a sh:NodeShape ;
  sh:name "Agent Role" ;
  sh:targetClass pro:RoleInTime ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue pro:RoleInTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:withRole ;
    sh:name "Role" ;
    sh:order 4 ;
    sh:hasValue pro:author ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isHeldBy ;
    sh:name "Held By" ;
    sh:order 2 ;
    sh:node schema:ResponsibleAgentShape ;
    sh:class foaf:Agent ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path oco:hasNext ;
    dash:hidden true ;
    sh:name "Has Next" ;
    sh:order 3 ;
    sh:node schema:AuthorShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT DISTINCT ?formattedName
        WHERE {
          $this pro:isHeldBy ?ra;
              pro:withRole pro:author.
          OPTIONAL { ?ra foaf:name ?name. }
          OPTIONAL { ?ra foaf:familyName ?familyName. }
          OPTIONAL { ?ra foaf:givenName ?givenName. }

          {
            SELECT ?ra (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              $this pro:isHeldBy ?ra .
              OPTIONAL {
                ?ra datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                          literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
            }
            GROUP BY ?ra
          }

          BIND(
            IF(BOUND(?name), ?name,
                IF(BOUND(?familyName) && BOUND(?givenName), CONCAT(?familyName, ", ", ?givenName),
                    IF(BOUND(?familyName), CONCAT(?familyName, ","), 
                        IF(BOUND(?givenName), CONCAT(",", ?givenName), "")
                    )
                )
            ) AS ?nameDisplay
          )

          BIND(STR(?ra) AS ?uriString)
          BIND(STRAFTER(?uriString, "https://w3id.org/oc/meta/") AS ?omid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                CONCAT(?nameDisplay, " [omid:", ?omid, " ", ?identifiers, "]"),
                CONCAT(?nameDisplay, " [omid:", ?omid, "]")
            ) AS ?formattedName)
        }
      """ ;
    ] ;
  ] .

schema:EditorShape
  a sh:NodeShape ;
  sh:name "Agent Role" ;
  sh:targetClass pro:RoleInTime ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue pro:RoleInTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:withRole ;
    sh:name "Role" ;
    sh:order 4 ;
    sh:hasValue pro:editor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isHeldBy ;
    sh:name "Held By" ;
    sh:order 2 ;
    sh:node schema:ResponsibleAgentShape ;
    sh:class foaf:Agent ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path oco:hasNext ;
    dash:hidden true ;
    sh:name "Has Next" ;
    sh:order 3 ;
    sh:node schema:EditorShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT DISTINCT ?formattedName
        WHERE {
          $this pro:isHeldBy ?ra;
              pro:withRole pro:editor.
          OPTIONAL { ?ra foaf:name ?name. }
          OPTIONAL { ?ra foaf:familyName ?familyName. }
          OPTIONAL { ?ra foaf:givenName ?givenName. }

          {
            SELECT ?ra (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              $this pro:isHeldBy ?ra .
              OPTIONAL {
                ?ra datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                          literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
            }
            GROUP BY ?ra
          }

          BIND(
            IF(BOUND(?name), ?name,
                IF(BOUND(?familyName) && BOUND(?givenName), CONCAT(?familyName, ", ", ?givenName),
                    IF(BOUND(?familyName), CONCAT(?familyName, ","), 
                        IF(BOUND(?givenName), CONCAT(",", ?givenName), "")
                    )
                )
            ) AS ?nameDisplay
          )

          BIND(STR(?ra) AS ?uriString)
          BIND(STRAFTER(?uriString, "https://w3id.org/oc/meta/") AS ?omid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                CONCAT(?nameDisplay, " [omid:", ?omid, " ", ?identifiers, "]"),
                CONCAT(?nameDisplay, " [omid:", ?omid, "]")
            ) AS ?formattedName)
        }
      """ ;
    ] ;
  ] .

schema:PublisherShape
  a sh:NodeShape ;
  sh:name "Agent Role" ;
  sh:targetClass pro:RoleInTime ;
  dash:hidden true ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type" ;
    sh:order 1 ;
    sh:hasValue pro:RoleInTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:withRole ;
    sh:name "Role" ;
    sh:order 4 ;
    sh:hasValue pro:publisher ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path pro:isHeldBy ;
    sh:name "Held By" ;
    sh:order 2 ;
    sh:node schema:ResponsibleAgentShape ;
    sh:class foaf:Agent ;
    shui:editor shui:AutoCompleteEditor ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path oco:hasNext ;
    dash:hidden true ;
    sh:name "Has Next" ;
    sh:order 3 ;
    sh:node schema:PublisherShape ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
    sh:values [
      sh:select """
        SELECT DISTINCT ?formattedName
        WHERE {
          $this pro:isHeldBy ?ra;
              pro:withRole pro:publisher.
          OPTIONAL { ?ra foaf:name ?name. }
          OPTIONAL { ?ra foaf:familyName ?familyName. }
          OPTIONAL { ?ra foaf:givenName ?givenName. }

          {
            SELECT ?ra (GROUP_CONCAT(?idString; separator=" ") AS ?identifiers)
            WHERE {
              $this pro:isHeldBy ?ra .
              OPTIONAL {
                ?ra datacite:hasIdentifier ?identifier .
                ?identifier datacite:usesIdentifierScheme ?scheme ;
                          literal:hasLiteralValue ?value .
                BIND(CONCAT(STRAFTER(STR(?scheme), "datacite/"), ":", ?value) AS ?idString)
              }
            }
            GROUP BY ?ra
          }

          BIND(
            IF(BOUND(?name), ?name,
                IF(BOUND(?familyName) && BOUND(?givenName), CONCAT(?familyName, ", ", ?givenName),
                    IF(BOUND(?familyName), CONCAT(?familyName, ","), 
                        IF(BOUND(?givenName), CONCAT(",", ?givenName), "")
                    )
                )
            ) AS ?nameDisplay
          )

          BIND(STR(?ra) AS ?uriString)
          BIND(STRAFTER(?uriString, "https://w3id.org/oc/meta/") AS ?omid)
          BIND(IF(BOUND(?identifiers) && STRLEN(?identifiers) > 0,
                CONCAT(?nameDisplay, " [omid:", ?omid, " ", ?identifiers, "]"),
                CONCAT(?nameDisplay, " [omid:", ?omid, "]")
            ) AS ?formattedName)
        }
      """ ;
    ] ;
  ] .
