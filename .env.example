SECRET_KEY=dev-secret-key-change-in-production

DATASET_DB_URL=http://localhost:7101
PROVENANCE_DB_URL=http://localhost:7103
DATASET_DB_TRIPLESTORE=qlever
PROVENANCE_DB_TRIPLESTORE=qlever
DATASET_IS_QUADSTORE=true
DATASET_DB_TEXT_INDEX_ENABLED=true
PROVENANCE_IS_QUADSTORE=true

# Folder with the configuration edited in the app: shacl.ttl, settings.db and
# the optional display_rules.yaml.
CONFIG_DIR=config

# Base of the IRIs that the built-in generator gives to new entities.
BASE_IRI=https://example.org

# ORCID iDs that can edit the configuration, separated by commas.
ADMIN_ORCIDS=your-orcid

ORCID_CLIENT_ID=your-client-id
ORCID_CLIENT_SECRET=your-client-secret

GUNICORN_WORKERS=2
