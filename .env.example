FLASK_ENV=demo
APP_TITLE=HERITRACE
APP_SUBTITLE=A semantic editor for heritage data
SECRET_KEY=dev-secret-key-change-in-production

CACHE_VALIDITY_DAYS=7
COUNT_LIMIT=10000

DATASET_DB_URL=http://host.docker.internal:8890/sparql
PROVENANCE_DB_URL=http://host.docker.internal:8891/sparql
DATASET_DB_TRIPLESTORE=virtuoso
PROVENANCE_DB_TRIPLESTORE=virtuoso
DATASET_DB_TEXT_INDEX_ENABLED=false
DATASET_IS_QUADSTORE=true
PROVENANCE_IS_QUADSTORE=true

ORCID_CLIENT_ID=your-client-id
ORCID_CLIENT_SECRET=your-client-secret
ORCID_SAFELIST=your-orcid-1,your-orcid-2

DATASET_GENERATION_TIME=2024-12-25T00:00:00+00:00
PRIMARY_SOURCE=https://example.org

# Base namespace for the IRIs minted by the default generator.
# Used only when URI_GENERATOR_CLASS/COUNTER_HANDLER_CLASS are left unset (see below).
BASE_IRI=https://example.org

ORPHAN_HANDLING_STRATEGY=ASK
PROXY_HANDLING_STRATEGY=ASK

CATALOGUE_DEFAULT_PER_PAGE=50
CATALOGUE_ALLOWED_PER_PAGE=50,100,200,500

# Optional IRI minting components. Leave these variables unset to use the built-in
# UUID generator and Redis counter handler. Options are JSON constructor arguments.
# COUNTER_HANDLER_CLASS=custom_components.my_counter.CounterHandler
# COUNTER_HANDLER_OPTIONS={}
# URI_GENERATOR_CLASS=custom_components.my_uri.URIGenerator
# URI_GENERATOR_OPTIONS={}

# Optional component invoked after dataset and provenance updates.
# SAVE_PLUGIN_CLASS=custom_components.my_save_plugin.SavePlugin
# SAVE_PLUGIN_OPTIONS={}

GUNICORN_WORKERS=2
MAX_WORKERS=8
BAKE=true
